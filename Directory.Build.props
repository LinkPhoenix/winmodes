<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Exact versions of every package, direct and transitive, are committed in packages.lock.json. CI restores in locked mode,
         so a build cannot silently pick a newer package. The runtime identifier is declared so the lock
         file also covers the self-contained publish of tools/package.ps1. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- A known vulnerability in any package, direct or transitive, is a restore error (warnings are errors here).
         Being offline only means the advisory list could not be read, so that one stays a warning. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
  </PropertyGroup>
</Project>

