<UserControl x:Class="WinModes.App.Controls.ViewModeSwitcher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WinModes.App.Localization"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <Style x:Key="ViewModeButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppCardStrokeBrush}"
            BorderThickness="1" CornerRadius="6" Padding="3">
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="CardsButton" Content="&#xE80A;" FontFamily="Segoe Fluent Icons" FontSize="16" Style="{StaticResource ViewModeButtonStyle}"
                         Checked="OnCardsChecked" ToolTip="{l:T 'Cards'}" AutomationProperties.Name="{l:T 'Cards'}" />
            <RadioButton x:Name="ListButton" Content="&#xE8A9;" FontFamily="Segoe Fluent Icons" FontSize="16" Style="{StaticResource ViewModeButtonStyle}"
                         Checked="OnListChecked" ToolTip="{l:T 'List'}" AutomationProperties.Name="{l:T 'List'}" />
            <RadioButton x:Name="CompactButton" Content="&#xE8FD;" FontFamily="Segoe Fluent Icons" FontSize="16" Style="{StaticResource ViewModeButtonStyle}"
                         Checked="OnCompactChecked" ToolTip="{l:T 'Compact'}" AutomationProperties.Name="{l:T 'Compact'}" />
        </StackPanel>
    </Border>
</UserControl>
