<UserControl x:Class="WinModes.App.Controls.WidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WinModes.App.Localization"
             xmlns:controls="clr-namespace:WinModes.App.Controls"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Border x:Name="Root" Width="270" Background="{StaticResource AppWidgetBrush}" BorderBrush="{StaticResource AppCardStrokeBrush}" BorderThickness="1"
            CornerRadius="12" Padding="16,14">
        <Grid>
        <!-- Compact mode: one line. -->
        <StackPanel x:Name="CompactPanel" Orientation="Horizontal" Visibility="Collapsed">
            <Ellipse x:Name="CompactModeDot" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="CompactCpuLabel" Text="CPU" FontSize="12" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock x:Name="CompactCpu" Text="…" FontWeight="SemiBold" Margin="6,0,14,0" Foreground="#A78BFA" />
            <TextBlock x:Name="CompactMemoryLabel" Text="RAM" FontSize="12" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock x:Name="CompactMemory" Text="…" FontWeight="SemiBold" Margin="6,0,14,0" Foreground="#F472B6" />
            <TextBlock x:Name="CompactAiLabel" Text="AI" FontSize="12" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock x:Name="CompactAi" Text="…" FontWeight="SemiBold" Margin="6,0,0,0" />
            <!-- Usage left on the Claude and Codex plans: the tool's icon, then the share left. -->
            <ItemsControl x:Name="CompactPlans" Visibility="Collapsed" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" Background="Transparent" Loaded="OnPlanLoaded">
                            <Image Source="{Binding Icon}" Width="14" Height="14" VerticalAlignment="Center"
                                   Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding Tool}" FontSize="12" VerticalAlignment="Center" Visibility="{Binding NameVisibility}"
                                       Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{Binding Short}" FontWeight="SemiBold" Margin="6,0,0,0" Foreground="{Binding ValueBrush}" />
                            <TextBlock Text="{Binding Resets}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding ResetsVisibility}"
                                       Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel x:Name="FullPanel">
            <Grid>
                <TextBlock Text="WINMODES" Style="{StaticResource CardCaptionStyle}" />
                <!-- Filled with the colour of the active mode, so the mode is recognised at a glance. -->
                <Border x:Name="ModeChip" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="9" Padding="9,2" Margin="0,-3,0,-3">
                    <TextBlock x:Name="ModeText" Text="{l:T 'No mode'}" FontSize="12" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" />
                </Border>
            </Grid>

            <Grid x:Name="CpuRow" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="CPU" FontSize="12" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                <controls:SegmentBar x:Name="CpuBar" Grid.Column="1" Height="12" Accent="#7C5CFC" />
                <TextBlock x:Name="CpuText" Grid.Column="2" Text="…" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>
            <Grid x:Name="MemoryRow" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="RAM" FontSize="12" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                <controls:SegmentBar x:Name="MemoryBar" Grid.Column="1" Height="12" Accent="#EC4899" />
                <TextBlock x:Name="MemoryText" Grid.Column="2" Text="…" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>
            <Grid x:Name="NetworkRow" Margin="0,8,0,0">
                <TextBlock Text="{l:T 'Network'}" FontSize="12" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock x:Name="NetworkText" Text="…" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>

            <Grid x:Name="GraphRow" Margin="0,10,0,0" Height="38" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:HistoryChart x:Name="CpuChart" Accent="#7C5CFC" />
                <controls:HistoryChart x:Name="MemoryChart" Grid.Column="2" Accent="#EC4899" />
            </Grid>

            <!-- Clicking the AI block opens the AI tools page. -->
            <StackPanel x:Name="AiSection" Background="Transparent" Cursor="Hand" ToolTip="{l:T 'Open the AI tools page'}">
                <Border x:Name="AiSeparator" Height="1" Background="{StaticResource AppCardStrokeBrush}" Margin="0,12,0,10" />
                <Grid>
                    <TextBlock Text="{l:T 'AI tools'}" FontWeight="SemiBold" />
                    <TextBlock x:Name="AiTotal" Text="…" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#A78BFA" />
                </Grid>
                <ItemsControl x:Name="AiTools" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Memory}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Plan, usage left and limit reset of Claude and Codex, from their local files. -->
            <StackPanel x:Name="PlanSection" Visibility="Collapsed">
                <Border x:Name="PlanSeparator" Height="1" Background="{StaticResource AppCardStrokeBrush}" Margin="0,12,0,10" />
                <TextBlock Text="{l:T 'Plans'}" FontWeight="SemiBold" />
                <TextBlock x:Name="PlanEmpty" Text="{l:T 'No Claude or Codex plan found on this PC'}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"
                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                <ItemsControl x:Name="Plans">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8,0,0" Background="Transparent" Loaded="OnPlanLoaded">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,70,0">
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                               Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Tool}" FontSize="12" FontWeight="SemiBold" Margin="0,0,5,0" VerticalAlignment="Center"
                                                   Visibility="{Binding NameVisibility}" />
                                        <TextBlock Text="{Binding Plan}" FontSize="12" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{Binding ValueBrush}" />
                                </Grid>
                                <!-- One bar per limit: the short window, then the weekly one when the plan has both. -->
                                <Grid Margin="0,5,0,0" Visibility="{Binding BarVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding WindowName}" FontSize="11" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                                    <controls:SegmentBar Grid.Column="1" Height="8" Accent="{Binding BarColor}" Value="{Binding Remaining}" />
                                </Grid>
                                <Grid Margin="0,4,0,0" Visibility="{Binding SecondBarVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SecondWindowName}" FontSize="11" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                                    <controls:SegmentBar Grid.Column="1" Height="8" Accent="{Binding SecondBarColor}" Value="{Binding SecondRemaining}" />
                                </Grid>
                                <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
        </Grid>
    </Border>
</UserControl>
