<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:WinModes.App.Controls">

    <Style TargetType="{x:Type controls:SearchField}" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style TargetType="{x:Type controls:PageHeader}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PageHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Margin="0,0,16,0" VerticalAlignment="Top"
                                Background="{TemplateBinding TileBrush}">
                            <ui:SymbolIcon Symbol="{TemplateBinding Icon}" Foreground="{TemplateBinding Accent}" FontSize="26"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Title}" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <ContentPresenter Margin="0,2,0,0" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="2" Content="{TemplateBinding Actions}" Margin="16,0,0,0" VerticalAlignment="Center"
                                          Visibility="{TemplateBinding ActionsVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:StatusBadge}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,6,4" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatusBadge}">
                    <Border Background="{TemplateBinding Tint}" CornerRadius="10" Padding="7,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{TemplateBinding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="11"
                                       Foreground="{TemplateBinding Tone}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="{TemplateBinding Text}" FontSize="11" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:EmptyState}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EmptyState}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource GlyphTextStyle}" FontSize="36" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{TemplateBinding Glyph}" />
                        <TextBlock Text="{TemplateBinding Title}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" TextAlignment="Center" />
                        <TextBlock Text="{TemplateBinding Hint}" Style="{DynamicResource SecondaryTextStyle}" HorizontalAlignment="Center"
                                   TextAlignment="Center" Margin="0,4,0,0" MaxWidth="420" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
