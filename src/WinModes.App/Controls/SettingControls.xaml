<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:WinModes.App.Controls">

    <Style TargetType="{x:Type controls:SettingRow}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingRow}">
                    <Border Padding="20,14" BorderThickness="{TemplateBinding DividerThickness}" BorderBrush="{DynamicResource AppCardStrokeBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{DynamicResource IconBadgeStyle}" Margin="0,0,14,0" Background="{TemplateBinding TileBrush}">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="{TemplateBinding Icon}" Foreground="{TemplateBinding Accent}" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{TemplateBinding GlyphVisibility}" />
                                        <Image Source="{TemplateBinding Picture}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" Visibility="{TemplateBinding PictureVisibility}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{TemplateBinding Description}" FontSize="12" Style="{DynamicResource SecondaryTextStyle}"
                                               Visibility="{TemplateBinding DescriptionVisibility}" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" Content="{TemplateBinding Control}" VerticalAlignment="Center" />
                            </Grid>
                            <!-- Aligned with the text, under the icon column. -->
                            <ContentPresenter Grid.Row="1" Content="{TemplateBinding Footer}"
                                              Visibility="{TemplateBinding FooterVisibility}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:SettingSection}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingSection}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="4,22,0,10">
                            <ui:SymbolIcon Symbol="{TemplateBinding Icon}" Foreground="{TemplateBinding Accent}" FontSize="16" VerticalAlignment="Center"
                                           Visibility="{TemplateBinding GlyphVisibility}" />
                            <Image Source="{TemplateBinding Picture}" Width="18" Height="18" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" Visibility="{TemplateBinding PictureVisibility}" />
                            <TextBlock Text="{TemplateBinding Header}" Style="{DynamicResource CardCaptionStyle}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Style="{DynamicResource CardBorderStyle}" Padding="0">
                            <ContentPresenter Content="{TemplateBinding Rows}" />
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
