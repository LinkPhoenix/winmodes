<ui:FluentWindow x:Class="WinModes.App.PolicyRecoveryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:l="clr-namespace:WinModes.App.Localization"
 Title="{l:T 'Policies and recovery'}" Width="960" Height="720" MinWidth="680" MinHeight="480"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource ApplicationBackgroundBrush}"
 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="{l:T 'Policies and recovery'}" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock x:Name="EnvironmentText" TextWrapping="Wrap" Margin="0,10,0,0"/>
   <TextBlock Text="{l:T 'A policy value can come from an installation script, even on Windows Home. Its presence does not prove that an organization manages this PC.'}" TextWrapping="Wrap" Margin="0,8,0,0"/>
   <TextBlock Text="{l:T 'Removing a policy returns it to an unconfigured state. It does not reconstruct settings or components removed by NTLite.'}" TextWrapping="Wrap" Margin="0,8,0,12"/>
  </StackPanel>
  <ComboBox Grid.Row="1" x:Name="Filter" SelectedIndex="0" SelectionChanged="OnFilterChanged" Margin="0,0,0,12" HorizontalAlignment="Left" MinWidth="240">
   <ComboBoxItem Content="{l:T 'Policy values present'}"/><ComboBoxItem Content="{l:T 'Settings with a disabled switch'}"/><ComboBoxItem Content="{l:T 'Recorded policy recoveries'}"/>
  </ComboBox>
  <ListBox Grid.Row="2" x:Name="Entries" SelectionChanged="OnSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
           AutomationProperties.Name="{l:T 'Policy and recovery settings'}">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
    <Setter Property="AutomationProperties.HelpText" Value="{Binding Reason}"/>
   </Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8" MaxWidth="780">
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Target}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
    <TextBlock Text="{Binding Observation}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
   </StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <TextBlock Grid.Row="3" x:Name="SelectionHelp" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <ui:Button x:Name="ReleaseButton" Content="{l:T 'Review policy removal'}" Click="OnRelease" IsEnabled="False" Margin="0,0,8,0"/>
   <ui:Button x:Name="UndoButton" Content="{l:T 'Review recovery undo'}" Click="OnUndo" IsEnabled="False" Margin="0,0,8,0"/>
   <ui:Button Content="{l:T 'Close'}" Click="OnClose"/>
  </StackPanel>
 </Grid>
</ui:FluentWindow>
