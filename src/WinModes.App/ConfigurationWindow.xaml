<ui:FluentWindow x:Class="WinModes.App.ConfigurationWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:l="clr-namespace:WinModes.App.Localization"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{l:T 'Configuration'}" Width="960" Height="720" MinWidth="600" MinHeight="420"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
                 Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ui:TitleBar Title="{l:T 'Configuration'}" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Grid.Row="1" Margin="24,12,24,12">
            <TextBlock Text="{l:T 'Prepare your Windows settings'}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{l:T 'Choose settings, save a configuration, or import one for review. Windows changes only when you apply from Optimize.'}"
                       TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,12" />
            <WrapPanel x:Name="ConfigurationActions">
                <ui:Button Content="{l:T 'Import configuration'}" Icon="{ui:SymbolIcon FolderOpen24}" Click="OnImport" Margin="0,0,8,8" />
                <ui:Button Content="{l:T 'Export configuration'}" Icon="{ui:SymbolIcon Save24}" Click="OnExport" Margin="0,0,8,8" />
                <ui:Button Content="{l:T 'Use current choices'}" Click="OnReset" Margin="0,0,8,8" />
                <ui:Button Content="{l:T 'Select supported'}" Click="OnSelect" Margin="0,0,8,8" />
                <ui:Button Content="{l:T 'Skip all'}" Click="OnSkip" Margin="0,0,0,8" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <ListBox x:Name="Choices" Grid.Row="2" Margin="24,0,24,16" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 HorizontalContentAlignment="Stretch" AutomationProperties.Name="{l:T 'Configuration settings'}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,6" Padding="12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Included}" IsEnabled="{Binding Supported}" Margin="0,0,12,0" VerticalAlignment="Center"
                                      AutomationProperties.Name="{Binding IncludeName}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Content="{l:T 'Desired: applied'}" IsChecked="{Binding Desired}" IsEnabled="{Binding Supported}" Margin="16,0,0,0"
                                      VerticalAlignment="Center" AutomationProperties.Name="{Binding DesiredName}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="3" BorderBrush="{DynamicResource AppCardStrokeBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <WrapPanel HorizontalAlignment="Right">
                <ui:Button x:Name="StageButton" Content="{l:T 'Review in Optimize'}" Appearance="Primary" Click="OnStage" Margin="0,0,8,0" />
                <ui:Button Content="{l:T 'Close'}" IsCancel="True" Click="OnClose" />
            </WrapPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
