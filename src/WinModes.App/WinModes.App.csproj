<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WinForms is used only for the notification-area icon (WPF has none). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WinModes</AssemblyName>
    <RootNamespace>WinModes.App</RootNamespace>
    <ApplicationIcon>Assets\winmodes.ico</ApplicationIcon>
    <Version>0.9.4-beta.20261007.3</Version>
    <!-- WPF0001: the Fluent ThemeMode API is still marked experimental in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\winmodes.ico" />
    <Resource Include="Assets\paypal-logo-blue.jpg" />
    <Resource Include="Assets\Software\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinModes.Core\WinModes.Core.csproj" />
    <ProjectReference Include="..\WinModes.Elevated\WinModes.Elevated.csproj" />
    <ProjectReference Include="..\WinModes.StatusLine\WinModes.StatusLine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
