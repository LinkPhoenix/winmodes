<Application x:Class="WinModes.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Controls/SettingControls.xaml" />
                <ResourceDictionary Source="Controls/PageControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Dark surfaces by default: near-black so the mode colours carry the interface. The light theme replaces these four at startup. -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0E0E12" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#191920" />
            <SolidColorBrush x:Key="AppCardStrokeBrush" Color="#2A2A34" />
            <!-- Slightly see-through card of the desktop widget. -->
            <SolidColorBrush x:Key="AppWidgetBrush" Color="#FF191920" />

            <FontFamily x:Key="GlyphFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <Style x:Key="GlyphTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource GlyphFontFamily}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Focusable" Value="False" />
            </Style>

            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CardCaptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!-- A category of a bar (Optimize, Debloat): a button whose colours follow the selection, set by the code since they differ per category. -->
            <Style x:Key="CategoryChipStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <!-- Without it the title takes the system button colour, which is black on the dark theme. -->
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chip" CornerRadius="16" Padding="12,6" Margin="0,0,8,8" BorderThickness="1"
                                    Background="{Binding Fill}" BorderBrush="{Binding Stroke}" Opacity="{Binding Emphasis}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="13" Margin="0,0,8,0" Text="{Binding Glyph}" Foreground="{Binding Color}" />
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Count}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="IconBadgeStyle" TargetType="Border">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="ChipStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
