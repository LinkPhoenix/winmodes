<Window x:Class="WinModes.App.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinModes.App.Controls"
        Title="WinModes widget"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        MouseLeftButtonDown="OnDrag">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Open WinModes" Click="OnOpenApp" />
            <MenuItem Header="Widget settings" Click="OnOpenSettings" />
            <MenuItem Header="Hide widget" Click="OnHide" />
        </ContextMenu>
    </Window.ContextMenu>

    <controls:WidgetView x:Name="View" />
</Window>
