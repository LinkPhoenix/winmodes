<ui:FluentWindow x:Class="WinModes.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:WinModes.App.Pages"
                 Title="WinModes"
                 Icon="pack://application:,,,/Assets/winmodes.ico"
                 Width="1240" Height="820" MinWidth="980" MinHeight="560"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{StaticResource AppBackgroundBrush}"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Title="WinModes">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/winmodes.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="220"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           TitleBar="{Binding ElementName=TitleBar, Mode=OneWay}">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Dashboard" Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem Content="Modes" Icon="{ui:SymbolIcon Flash24}"
                                       TargetPageType="{x:Type pages:ModesPage}" />
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem Content="Processes" Icon="{ui:SymbolIcon Apps24}"
                                       TargetPageType="{x:Type pages:ProcessesPage}" />
                <ui:NavigationViewItem Content="AI tools" Icon="{ui:SymbolIcon Bot24}"
                                       TargetPageType="{x:Type pages:AiToolsPage}" />
                <ui:NavigationViewItem Content="Services" Icon="{ui:SymbolIcon Server24}"
                                       TargetPageType="{x:Type pages:ServicesPage}" />
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem Content="History" Icon="{ui:SymbolIcon History24}"
                                       TargetPageType="{x:Type pages:HistoryPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings" Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type pages:SettingsPage}" />
                <ui:NavigationViewItem Content="Protection" Icon="{ui:SymbolIcon Shield24}"
                                       TargetPageType="{x:Type pages:ProtectionPage}" />
                <ui:NavigationViewItem Content="About" Icon="{ui:SymbolIcon Info24}"
                                       TargetPageType="{x:Type pages:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
