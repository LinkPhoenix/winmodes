<ui:FluentWindow x:Class="WinModes.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:l="clr-namespace:WinModes.App.Localization"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:WinModes.App.Pages"
                 Title="WinModes"
                 Icon="pack://application:,,,/Assets/winmodes.ico"
                 Width="1240" Height="820" MinWidth="980" MinHeight="560"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{StaticResource AppBackgroundBrush}"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- One row: pane toggle, icon, name and version on the left; the window buttons on the right. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- The toggle sits outside the title bar so it receives clicks instead of dragging the window. -->
            <ui:Button x:Name="PaneToggle" Width="40" Height="36" Margin="4,6,0,6" Padding="0"
                       Appearance="Transparent" BorderThickness="0" Click="OnTogglePane"
                       Icon="{ui:SymbolIcon Navigation24}" ToolTip="{l:T 'Open or close the menu'}"
                       AutomationProperties.Name="{l:T 'Toggle navigation'}" />
            <ui:TitleBar x:Name="TitleBar" Grid.Column="1" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                <Image Source="pack://application:,,,/Assets/winmodes.ico" Width="20" Height="20" />
                <TextBlock Text="WinModes" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBlock x:Name="VersionText" FontSize="12" VerticalAlignment="Center" Margin="8,1,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="220"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           FrameMargin="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{l:T 'Dashboard'}" Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem Content="{l:T 'Modes'}" Icon="{ui:SymbolIcon Flash24}"
                                       TargetPageType="{x:Type pages:ModesPage}" />
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem Content="{l:T 'Processes'}" Icon="{ui:SymbolIcon Apps24}"
                                       TargetPageType="{x:Type pages:ProcessesPage}" />
                <ui:NavigationViewItem Content="{l:T 'AI tools'}" Icon="{ui:SymbolIcon Bot24}"
                                       TargetPageType="{x:Type pages:AiToolsPage}" />
                <ui:NavigationViewItem Content="{l:T 'Usage'}" Icon="{ui:SymbolIcon DataHistogram24}"
                                       TargetPageType="{x:Type pages:UsagePage}" />
                <ui:NavigationViewItem Content="{l:T 'Services'}" Icon="{ui:SymbolIcon Server24}"
                                       TargetPageType="{x:Type pages:ServicesPage}" />
                <ui:NavigationViewItem Content="{l:T 'Optimize'}" Icon="{ui:SymbolIcon Wand24}"
                                       TargetPageType="{x:Type pages:OptimizePage}" />
                <ui:NavigationViewItem Content="{l:T 'Startup'}" Icon="{ui:SymbolIcon Rocket24}"
                                       TargetPageType="{x:Type pages:StartupPage}" />
                <ui:NavigationViewItem Content="{l:T 'Debloat'}" Icon="{ui:SymbolIcon Broom24}"
                                       TargetPageType="{x:Type pages:DebloatPage}" />
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem Content="{l:T 'Automation'}" Icon="{ui:SymbolIcon ArrowSync24}"
                                       TargetPageType="{x:Type pages:AutomationPage}" />
                <ui:NavigationViewItem Content="{l:T 'Widget'}" Icon="{ui:SymbolIcon PictureInPicture24}"
                                       TargetPageType="{x:Type pages:WidgetPage}" />
                <ui:NavigationViewItem Content="{l:T 'Notifications'}" Icon="{ui:SymbolIcon Alert24}"
                                       TargetPageType="{x:Type pages:NotificationsPage}" />
                <ui:NavigationViewItem Content="{l:T 'History'}" Icon="{ui:SymbolIcon History24}"
                                       TargetPageType="{x:Type pages:HistoryPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{l:T 'Settings'}" Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type pages:SettingsPage}" />
                <ui:NavigationViewItem Content="{l:T 'Protection'}" Icon="{ui:SymbolIcon Shield24}"
                                       TargetPageType="{x:Type pages:ProtectionPage}" />
                <ui:NavigationViewItem Content="{l:T 'About'}" Icon="{ui:SymbolIcon Info24}"
                                       TargetPageType="{x:Type pages:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- First-run guide, created only when needed; it covers the pages but not the title bar. -->
        <ContentControl x:Name="OnboardingHost" Grid.Row="1" Visibility="Collapsed" Focusable="False" />
    </Grid>
</ui:FluentWindow>
