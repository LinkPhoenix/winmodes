<ui:FluentWindow x:Class="WinModes.App.SupportWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:l="clr-namespace:WinModes.App.Localization"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:WinModes.App"
                 Title="{l:T 'Support WinModes'}" Width="640" Height="620"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
                 Background="{DynamicResource AppBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{l:T 'Support WinModes'}" ShowMinimize="False" ShowMaximize="False" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,12,28,20">
                <ui:SymbolIcon Symbol="Heart24" FontSize="36" HorizontalAlignment="Left" Margin="0,0,0,16" />
                <TextBlock Text="{l:T 'Help WinModes keep improving'}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{l:T 'If WinModes helps you, you can support its development with a voluntary donation.'}"
                           TextWrapping="Wrap" Margin="0,10,0,22" Style="{StaticResource SecondaryTextStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Support the developer'}" Style="{StaticResource CardCaptionStyle}" />
                        <TextBlock Text="Emilio LECERF" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,12" />
                        <Border Background="{x:Static app:Palette.PayPalLogoBackground}" Padding="12" CornerRadius="6" HorizontalAlignment="Left">
                            <Image Source="pack://application:,,,/Assets/paypal-logo-blue.jpg" Width="111" Height="69"
                                   Stretch="Uniform" AutomationProperties.Name="PayPal" />
                        </Border>
                        <TextBlock Text="paypal.me/EmilioLECERF" Margin="0,12,0,14" Style="{StaticResource SecondaryTextStyle}" />
                        <ui:Button Content="{l:T 'Donate with PayPal'}" Appearance="Primary"
                                   Icon="{ui:SymbolIcon Open24}" HorizontalAlignment="Left" Click="OnDonate" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{l:T 'Choose your amount on PayPal. Your donation is optional and does not unlock extra features.'}"
                           TextWrapping="Wrap" Margin="0,16,0,0" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="{l:T 'PayPal opens in your default browser.'}" TextWrapping="Wrap"
                           Margin="0,6,0,0" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
        <ui:Button Grid.Row="2" Content="{l:T 'Close'}" IsCancel="True"
                   HorizontalAlignment="Right" MinWidth="110" Margin="28,0,28,20" Click="OnClose" />
    </Grid>
</ui:FluentWindow>
