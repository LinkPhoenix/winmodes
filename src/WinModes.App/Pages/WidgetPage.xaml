<Page x:Class="WinModes.App.Pages.WidgetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinModes.App.Localization"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:app="clr-namespace:WinModes.App"
      xmlns:controls="clr-namespace:WinModes.App.Controls"
      Title="{l:T 'Widget'}"
      ScrollViewer.CanContentScroll="False"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- The page scrolls its options itself (the shell's scrolling is off) so the preview stays in view. -->
    <Grid Margin="36,24,0,0" MaxWidth="1136">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
            <StackPanel Margin="0,0,0,36">
                <controls:PageHeader Title="{l:T 'Widget'}" Icon="PictureInPicture24" Accent="{x:Static app:Palette.Container}" Margin="0,0,0,0">
                    <TextBlock Text="{l:T 'A small panel with live figures, on your desktop or on the taskbar. Changes apply at once.'}"
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                </controls:PageHeader>

                <controls:SettingSection Header="{l:T 'GENERAL'}" Icon="Settings24" Accent="{x:Static app:Palette.BrandBrush}">
                    <StackPanel>
                        <controls:SettingRow Icon="WindowApps24" Accent="{x:Static app:Palette.BrandBrush}"
                                             Title="{l:T 'Show the widget'}" Description="{l:T 'You can also hide it from its right-click menu.'}">
                            <ui:ToggleSwitch x:Name="Enabled" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'Show the widget'}" />
                        </controls:SettingRow>
                        <controls:SettingRow Icon="Desktop24" Accent="{x:Static app:Palette.Apps}" Title="{l:T 'Where it appears'}"
                                             Description="{l:T 'On the desktop it floats where you drop it. On the taskbar it sits in the free room next to the app icons and shows less when there is little room.'}">
                            <ComboBox x:Name="Place" MinWidth="170" DisplayMemberPath="Label"
                                      SelectionChanged="OnSelectionChanged" AutomationProperties.Name="{l:T 'Where it appears'}" />
                        </controls:SettingRow>
                        <controls:SettingRow x:Name="SideRow" Icon="AlignLeft24" Accent="{x:Static app:Palette.Start}" Title="{l:T 'Side of the taskbar'}"
                                             Description="{l:T 'Automatic picks the side with the most room, wherever the app icons are. If your choice has no room, the other side is used.'}">
                            <ComboBox x:Name="Side" MinWidth="170" DisplayMemberPath="Label"
                                      SelectionChanged="OnSelectionChanged" AutomationProperties.Name="{l:T 'Side of the taskbar'}" />
                        </controls:SettingRow>
                        <controls:SettingRow x:Name="AlwaysOnTopRow" Icon="Pin24" Accent="{x:Static app:Palette.Container}"
                                             Title="{l:T 'Always on top'}" Description="{l:T 'Keep the widget above every other window.'}">
                            <ui:ToggleSwitch x:Name="AlwaysOnTop" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'Always on top'}" />
                        </controls:SettingRow>
                        <controls:SettingRow Icon="FullScreenMaximize24" Accent="{x:Static app:Palette.Apps}"
                                             Title="{l:T 'Hide during full-screen apps'}"
                                             Description="{l:T 'The widget disappears while a game, a video or a presentation fills the screen.'}">
                            <ui:ToggleSwitch x:Name="HideOnFullScreen" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'Hide during full-screen apps'}" />
                        </controls:SettingRow>
                        <controls:SettingRow Icon="ArrowSync24" Accent="{x:Static app:Palette.Start}" Title="{l:T 'Refresh every'}">
                            <ComboBox x:Name="Refresh" MinWidth="170" DisplayMemberPath="Label"
                                      SelectionChanged="OnSelectionChanged" AutomationProperties.Name="{l:T 'Refresh interval'}" />
                        </controls:SettingRow>
                    </StackPanel>
                </controls:SettingSection>

                <controls:SettingSection Header="{l:T 'APPEARANCE'}" Icon="PaintBrush24" Accent="{x:Static app:Palette.Apps}">
                    <StackPanel>
                        <controls:SettingRow Icon="Drop24" Accent="{x:Static app:Palette.Container}" Title="{l:T 'Opacity'}">
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="OpacitySlider" Width="160" Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" ValueChanged="OnOpacityChanged" AutomationProperties.Name="{l:T 'Opacity'}" />
                                <TextBlock x:Name="OpacityText" Width="48" TextAlignment="Right" VerticalAlignment="Center" />
                            </StackPanel>
                        </controls:SettingRow>
                        <controls:SettingRow x:Name="CompactRow" Icon="ArrowMinimize24" Accent="{x:Static app:Palette.Power}"
                                             Title="{l:T 'Compact'}" Description="{l:T 'One line with CPU, memory and the AI total.'}">
                            <ui:ToggleSwitch x:Name="Compact" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'Compact'}" />
                        </controls:SettingRow>
                        <controls:SettingRow x:Name="ScaleRow" Icon="ResizeLarge24" Accent="{x:Static app:Palette.Start}" Title="{l:T 'Size'}">
                            <ComboBox x:Name="Scale" MinWidth="170" DisplayMemberPath="Label"
                                      SelectionChanged="OnSelectionChanged" AutomationProperties.Name="{l:T 'Size'}" />
                        </controls:SettingRow>
                    </StackPanel>
                </controls:SettingSection>

                <controls:SettingSection Header="{l:T 'CONTENT'}" Icon="DataBarVertical24" Accent="{x:Static app:Palette.Container}">
                    <StackPanel>
                        <controls:SettingRow Icon="DeveloperBoard24" Accent="{x:Static app:Palette.BrandBrush}" Title="CPU">
                            <ui:ToggleSwitch x:Name="ShowCpu" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'Show CPU'}" />
                        </controls:SettingRow>
                        <controls:SettingRow Icon="Memory16" Accent="{x:Static app:Palette.Stop}" Title="{l:T 'Memory'}">
                            <ui:ToggleSwitch x:Name="ShowMemory" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'Show memory'}" />
                        </controls:SettingRow>
                        <controls:SettingRow Icon="DataLine24" Accent="{x:Static app:Palette.Apps}"
                                             Title="{l:T 'History graphs'}" Description="{l:T 'Small CPU and memory graphs under the bars.'}">
                            <ui:ToggleSwitch x:Name="ShowGraph" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'History graphs'}" />
                        </controls:SettingRow>
                        <controls:SettingRow Icon="Wifi124" Accent="{x:Static app:Palette.Container}" Title="{l:T 'Network speed'}">
                            <ui:ToggleSwitch x:Name="ShowNetwork" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'Show network speed'}" />
                        </controls:SettingRow>
                        <controls:SettingRow Icon="Flash24" Accent="{x:Static app:Palette.Power}" Title="{l:T 'Active mode'}">
                            <ui:ToggleSwitch x:Name="ShowMode" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'Show active mode'}" />
                        </controls:SettingRow>
                        <controls:SettingRow Icon="Bot24" Accent="{x:Static app:Palette.Apps}" Title="{l:T 'AI tools total'}">
                            <ui:ToggleSwitch x:Name="ShowAiTools" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'Show AI tools total'}" />
                        </controls:SettingRow>
                        <controls:SettingRow Icon="List24" Accent="{x:Static app:Palette.Neutral}" Title="{l:T 'Detail per AI tool'}">
                            <ui:ToggleSwitch x:Name="ShowToolDetail" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'Show detail per AI tool'}" />
                        </controls:SettingRow>
                        <controls:SettingRow Icon="NumberSymbol24" Accent="{x:Static app:Palette.Neutral}" Title="{l:T 'AI tools listed'}">
                            <ComboBox x:Name="MaxTools" MinWidth="170" DisplayMemberPath="Label"
                                      SelectionChanged="OnSelectionChanged" AutomationProperties.Name="{l:T 'Number of AI tools listed'}" />
                        </controls:SettingRow>
                    </StackPanel>
                </controls:SettingSection>

                <controls:SettingSection Header="{l:T 'PLAN USAGE'}" Icon="Gauge24" Accent="{x:Static app:Palette.Start}">
                    <StackPanel>
                        <controls:SettingRow Icon="Gauge24" Accent="{x:Static app:Palette.BrandBrush}" Title="{l:T 'Show plan usage'}"
                                             Description="{l:T 'Your plan, the usage left and when the limit resets, for Claude, Codex and Grok, read from your accounts. Sign in to each one in the sections below: nothing is read from the files of these tools.'}">
                            <ui:ToggleSwitch x:Name="ShowSubscriptions" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'Show plan usage'}" />
                        </controls:SettingRow>
                        <controls:SettingRow Icon="DataPie24" Accent="{x:Static app:Palette.BrandBrush}" Title="{l:T 'Limits on the taskbar'}"
                                             Description="{l:T 'Bars show each limit with its percentage beside it. Rings take about half the width: the percentage left is inside the ring.'}">
                            <ComboBox x:Name="PlanStyleBox" MinWidth="170" DisplayMemberPath="Label"
                                      SelectionChanged="OnSelectionChanged" AutomationProperties.Name="{l:T 'Limits on the taskbar'}" />
                        </controls:SettingRow>
                    </StackPanel>
                </controls:SettingSection>

                <controls:SettingSection x:Name="ClaudeSection" Header="{l:T 'CLAUDE CODE'}" Icon="Sparkle24" Accent="{x:Static app:Palette.Power}">
                    <StackPanel>
                        <controls:SettingRow x:Name="ClaudeAccountRow" Icon="Person24" Accent="{x:Static app:Palette.Power}" Title="{l:T 'WinModes account'}">
                            <ui:Button x:Name="ClaudeAccountButton" MinWidth="110" Click="OnClaudeAccount" AutomationProperties.Name="{l:T 'WinModes account'}" />
                        </controls:SettingRow>
                        <controls:SettingRow Icon="Eye24" Accent="{x:Static app:Palette.Power}" Title="{l:T 'Show Claude usage'}"
                                             Description="{l:T 'Claude is listed in the plans block of the widget. Turned off, it is neither read nor asked online.'}">
                            <ui:ToggleSwitch x:Name="ShowClaudePlan" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'Show Claude usage'}" />
                        </controls:SettingRow>
                        <controls:SettingRow x:Name="ClaudeUsageRow" Icon="Record24" Accent="{x:Static app:Palette.Power}" Title="{l:T 'Record Claude usage'}"
                                             Visibility="Collapsed"
                                             Description="{l:T 'WinModes no longer reads this record. Switch it off to remove the WinModes status line from the Claude Code settings.'}">
                            <ui:ToggleSwitch x:Name="ClaudeUsage" Click="OnClaudeUsageClicked" AutomationProperties.Name="{l:T 'Record Claude usage'}" />
                        </controls:SettingRow>
                    </StackPanel>
                </controls:SettingSection>

                <controls:SettingSection x:Name="CodexSection" Header="{l:T 'CODEX'}" Icon="Code24" Accent="{x:Static app:Palette.Container}">
                    <StackPanel>
                        <controls:SettingRow x:Name="CodexAccountRow" Icon="Person24" Accent="{x:Static app:Palette.Container}" Title="{l:T 'WinModes account'}">
                            <ui:Button x:Name="CodexAccountButton" MinWidth="110" Click="OnCodexAccount" AutomationProperties.Name="{l:T 'WinModes account'}" />
                        </controls:SettingRow>
                        <controls:SettingRow Icon="Eye24" Accent="{x:Static app:Palette.Container}" Title="{l:T 'Show Codex usage'}"
                                             Description="{l:T 'Codex is listed in the plans block of the widget. Turned off, it is neither read nor asked online.'}">
                            <ui:ToggleSwitch x:Name="ShowCodexPlan" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'Show Codex usage'}" />
                        </controls:SettingRow>
                        <controls:SettingRow Icon="ArrowCounterclockwise24" Accent="{x:Static app:Palette.Start}" Title="{l:T 'Limit resets in reserve'}"
                                             Description="{l:T 'How many resets of the usage limit your account holds, shown as ↻ and a number in the compact layout. Only Codex gives it, and only with the online reading.'}">
                            <ui:ToggleSwitch x:Name="ShowResetCredits" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'Show limit resets in reserve'}" />
                        </controls:SettingRow>
                    </StackPanel>
                </controls:SettingSection>

                <controls:SettingSection x:Name="GrokSection" Header="{l:T 'GROK'}" Icon="Bot24" Accent="{x:Static app:Palette.Apps}">
                    <StackPanel>
                        <controls:SettingRow x:Name="GrokAccountRow" Icon="Person24" Accent="{x:Static app:Palette.Apps}" Title="{l:T 'WinModes account'}">
                            <ui:Button x:Name="GrokAccountButton" MinWidth="110" Click="OnGrokAccount" AutomationProperties.Name="{l:T 'WinModes account'}" />
                        </controls:SettingRow>
                        <controls:SettingRow Icon="Eye24" Accent="{x:Static app:Palette.Apps}" Title="{l:T 'Show Grok usage'}"
                                             Description="{l:T 'Grok is listed in the plans block of the widget. Turned off, it is neither read nor asked online.'}">
                            <ui:ToggleSwitch x:Name="ShowGrokPlan" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'Show Grok usage'}" />
                        </controls:SettingRow>
                    </StackPanel>
                </controls:SettingSection>

                <controls:SettingSection x:Name="PositionSection" Header="{l:T 'POSITION AND MOUSE'}" Icon="CursorHover24" Accent="{x:Static app:Palette.Apps}">
                    <StackPanel>
                        <controls:SettingRow Icon="PositionToFront24" Accent="{x:Static app:Palette.BrandBrush}" Title="{l:T 'Move to a corner'}"
                                             Description="{l:T 'Otherwise drag the widget where you want; its position is remembered.'}">
                            <WrapPanel MaxWidth="210">
                                <ui:Button Content="{l:T 'Top left'}" Tag="TopLeft" Margin="0,0,6,6" Click="OnCorner" />
                                <ui:Button Content="{l:T 'Top right'}" Tag="TopRight" Margin="0,0,6,6" Click="OnCorner" />
                                <ui:Button Content="{l:T 'Bottom left'}" Tag="BottomLeft" Margin="0,0,6,6" Click="OnCorner" />
                                <ui:Button Content="{l:T 'Bottom right'}" Tag="BottomRight" Margin="0,0,6,6" Click="OnCorner" />
                            </WrapPanel>
                        </controls:SettingRow>
                        <controls:SettingRow Icon="LockClosed24" Accent="{x:Static app:Palette.Power}"
                                             Title="{l:T 'Lock position'}" Description="{l:T 'The widget cannot be dragged by mistake.'}">
                            <ui:ToggleSwitch x:Name="LockPosition" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'Lock position'}" />
                        </controls:SettingRow>
                        <controls:SettingRow Icon="CursorClick24" Accent="{x:Static app:Palette.Container}" Title="{l:T 'Click-through'}"
                                             Description="{l:T 'Clicks pass through the widget to the window underneath. Its right-click menu is then unavailable: come back here to change it.'}">
                            <ui:ToggleSwitch x:Name="ClickThrough" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="{l:T 'Click-through'}" />
                        </controls:SettingRow>
                    </StackPanel>
                </controls:SettingSection>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="1" Margin="14,56,36,0" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Margin="4,20,0,10">
                <ui:SymbolIcon Symbol="Eye24" FontSize="16" Foreground="{x:Static app:Palette.BrandBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{l:T 'PREVIEW'}" Style="{StaticResource CardCaptionStyle}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Border Width="330" MinHeight="250" CornerRadius="10" Padding="20"
                    BorderBrush="{StaticResource AppCardStrokeBrush}" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B2350" Offset="0" />
                        <GradientStop Color="#16202E" Offset="0.55" />
                        <GradientStop Color="#3A1C36" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <!-- A long compact line is scaled down to fit instead of being cut. -->
                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:WidgetView x:Name="Preview" />
                </Viewbox>
            </Border>
            <TextBlock x:Name="PreviewNote" FontSize="12" Margin="4,8,0,0" MaxWidth="330" HorizontalAlignment="Left"
                       Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
    </Grid>
</Page>
