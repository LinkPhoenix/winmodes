<Page x:Class="WinModes.App.Pages.AutomationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinModes.App.Localization"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Automation'}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="RowStyle" TargetType="Border">
            <Setter Property="Padding" Value="20,14" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource AppCardStrokeBrush}" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CardCaptionStyle}">
            <Setter Property="Margin" Value="4,20,0,8" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="36,24,36,36" MaxWidth="1100">
        <TextBlock Text="{l:T 'Automation'}" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="{l:T 'Let WinModes activate a mode by itself when a program starts, on battery, or at set hours. Off until you turn it on.'}"
                   Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />

        <TextBlock Text="{l:T 'AUTOMATIC SWITCHING'}" Style="{StaticResource SectionTitleStyle}" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <StackPanel>
                <Border Style="{StaticResource RowStyle}">
                    <Grid>
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock Text="{l:T 'Switch modes automatically'}" FontWeight="SemiBold" />
                            <TextBlock FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                       Text="{l:T 'WinModes checks every few seconds whether a rule below applies. Windows asks for permission at each switch unless the option below is on.'}" />
                            <TextBlock x:Name="StateText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="Enabled" HorizontalAlignment="Right" Checked="OnChanged" Unchecked="OnChanged"
                                         AutomationProperties.Name="{l:T 'Switch modes automatically'}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource RowStyle}">
                    <Grid>
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock Text="{l:T 'Switch without the Windows permission prompt'}" FontWeight="SemiBold" />
                            <TextBlock x:Name="SilentDetail" FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                       Text="{l:T 'Windows asks once, now, to register a scheduled task; after that every mode switch, automatic or by hand, happens with no prompt. The task can only activate or undo a mode.'}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="Silent" HorizontalAlignment="Right" Click="OnSilentClicked"
                                         AutomationProperties.Name="{l:T 'Switch without the Windows permission prompt'}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource RowStyle}">
                    <Grid>
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock Text="{l:T 'Return to normal when the rule no longer applies'}" FontWeight="SemiBold" />
                            <TextBlock FontSize="12" Style="{StaticResource SecondaryTextStyle}"
                                       Text="{l:T 'Only a mode activated automatically is undone. A mode you chose yourself is never changed.'}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="RevertWhenClosed" HorizontalAlignment="Right" Checked="OnChanged" Unchecked="OnChanged"
                                         AutomationProperties.Name="{l:T 'Return to normal when the rule no longer applies'}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource RowStyle}" BorderThickness="0">
                    <Grid>
                        <StackPanel Margin="0,0,200,0">
                            <TextBlock Text="{l:T 'Wait before returning to normal'}" FontWeight="SemiBold" />
                            <TextBlock FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                       Text="{l:T 'When the last program or tool that started a mode closes, the mode stays this long. Going from one tool to another, or having several open, never makes the PC go back and forth.'}" />
                        </StackPanel>
                        <ComboBox x:Name="Grace" HorizontalAlignment="Right" MinWidth="150" DisplayMemberPath="Label" SelectionChanged="OnGraceChanged"
                                  AutomationProperties.Name="{l:T 'Wait before returning to normal'}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="{l:T 'CODING TOOLS'}" Style="{StaticResource SectionTitleStyle}" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <StackPanel>
                <Border Style="{StaticResource RowStyle}">
                    <Grid>
                        <StackPanel Margin="0,0,200,0">
                            <TextBlock Text="{l:T 'Start a mode while a coding tool is open'}" FontWeight="SemiBold" />
                            <TextBlock FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                       Text="{l:T 'Opening any tool switched on below starts this mode, and it ends once the last one has been closed for the wait set above. Claude Code is told apart from the Claude chat app.'}" />
                        </StackPanel>
                        <ComboBox x:Name="ToolMode" HorizontalAlignment="Right" MinWidth="150" DisplayMemberPath="Label" SelectionChanged="OnToolModeChanged"
                                  AutomationProperties.Name="{l:T 'Mode started by the coding tools'}" />
                    </Grid>
                </Border>
                <ItemsControl x:Name="Tools">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowStyle}" Padding="20,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{Binding Tint}">
                                        <Grid>
                                            <Image Source="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="15" HorizontalAlignment="Center" Text="&#xE943;"
                                                       Visibility="{Binding GlyphVisibility}" Foreground="{Binding Color}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" />
                                    <Border Grid.Column="2" Style="{StaticResource ChipStyle}" Margin="0,0,16,0" VerticalAlignment="Center"
                                            Visibility="{Binding RunningVisibility}" Background="{Binding Tint}">
                                        <TextBlock Text="{l:T 'Open now'}" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                    <ui:ToggleSwitch Grid.Column="3" IsChecked="{Binding IsOn, Mode=OneWay}" Click="OnToolToggled"
                                                     AutomationProperties.Name="{Binding Name}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Text="{l:T 'RULES'}" Style="{StaticResource SectionTitleStyle}" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <StackPanel>
                <TextBlock x:Name="EmptyState" Margin="20,16" Style="{StaticResource SecondaryTextStyle}"
                           Text="{l:T 'No other rule yet. Add one below, for example your game launcher with Game mode.'}" />
                <ItemsControl x:Name="Rules">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconBadgeStyle}" Background="{Binding Accent}">
                                        <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="16" HorizontalAlignment="Center" Text="{Binding Glyph}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock FontSize="12" Style="{StaticResource SecondaryTextStyle}" Text="{Binding Detail}" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" Content="{l:T 'Remove'}" Icon="{ui:SymbolIcon Delete24}" Click="OnRemove"
                                               AutomationProperties.Name="{l:T 'Remove rule'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="Trigger" MinWidth="190" Margin="0,0,12,0" DisplayMemberPath="Label"
                                  SelectionChanged="OnTriggerChanged" AutomationProperties.Name="{l:T 'Trigger'}" />
                        <ComboBox x:Name="ProcessName" Grid.Column="1" IsEditable="True" DropDownOpened="OnProcessListOpened"
                                  ToolTip="{l:T 'Program name, for example cs2.exe. Open the list to pick a running program.'}"
                                  AutomationProperties.Name="{l:T 'Program name'}" />
                        <StackPanel x:Name="TimeRange" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock Text="{l:T 'from'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ui:TextBox x:Name="TimeFrom" Width="90" PlaceholderText="09:00" AutomationProperties.Name="{l:T 'Start time'}" />
                            <TextBlock Text="{l:T 'to'}" VerticalAlignment="Center" Margin="10,0,8,0" />
                            <ui:TextBox x:Name="TimeTo" Width="90" PlaceholderText="18:00" AutomationProperties.Name="{l:T 'End time'}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{l:T 'activate'}" VerticalAlignment="Center" Margin="12,0" />
                        <ComboBox x:Name="Mode" Grid.Column="3" MinWidth="150" DisplayMemberPath="Label" AutomationProperties.Name="{l:T 'Mode to activate'}" />
                        <ui:Button Grid.Column="4" Content="{l:T 'Add rule'}" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Margin="12,0,0,0" Click="OnAdd" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
        <TextBlock x:Name="Status" FontSize="12" Margin="4,10,0,0" Style="{StaticResource SecondaryTextStyle}" />

        <TextBlock Margin="4,16,0,0" FontSize="12" Style="{StaticResource SecondaryTextStyle}"
                   Text="{l:T 'Rules are checked from top to bottom: the first one that applies wins. A rule acts once each time it starts to apply, so undoing a mode by hand is respected. The protected list applies to automatic switches exactly as to manual ones.'}" />
    </StackPanel>
</Page>
