<Page x:Class="WinModes.App.Pages.AutomationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Automation"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="RowStyle" TargetType="Border">
            <Setter Property="Padding" Value="20,14" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource AppCardStrokeBrush}" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CardCaptionStyle}">
            <Setter Property="Margin" Value="4,20,0,8" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="36,24,36,36" MaxWidth="1100">
        <TextBlock Text="Automation" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="Let WinModes activate a mode by itself when a program starts. Off until you turn it on."
                   Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />

        <TextBlock Text="AUTOMATIC SWITCHING" Style="{StaticResource SectionTitleStyle}" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <StackPanel>
                <Border Style="{StaticResource RowStyle}">
                    <Grid>
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock Text="Switch modes automatically" FontWeight="SemiBold" />
                            <TextBlock FontSize="12" Style="{StaticResource SecondaryTextStyle}"
                                       Text="WinModes checks every few seconds for the programs listed below. Windows still asks for permission at each switch that changes services." />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="Enabled" HorizontalAlignment="Right" Checked="OnChanged" Unchecked="OnChanged"
                                         AutomationProperties.Name="Switch modes automatically" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource RowStyle}" BorderThickness="0">
                    <Grid>
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock Text="Return to normal when the program closes" FontWeight="SemiBold" />
                            <TextBlock FontSize="12" Style="{StaticResource SecondaryTextStyle}"
                                       Text="Only a mode activated automatically is undone. A mode you chose yourself is never changed." />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="RevertWhenClosed" HorizontalAlignment="Right" Checked="OnChanged" Unchecked="OnChanged"
                                         AutomationProperties.Name="Return to normal when the program closes" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="RULES" Style="{StaticResource SectionTitleStyle}" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <StackPanel>
                <TextBlock x:Name="EmptyState" Margin="20,16" Style="{StaticResource SecondaryTextStyle}"
                           Text="No rule yet. Add one below, for example your game launcher with Game mode." />
                <ItemsControl x:Name="Rules">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconBadgeStyle}" Background="{Binding Accent}">
                                        <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="16" HorizontalAlignment="Center" Text="{Binding Glyph}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock FontSize="12" Style="{StaticResource SecondaryTextStyle}" Text="{Binding Detail}" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" Content="Remove" Icon="{ui:SymbolIcon Delete24}" Click="OnRemove"
                                               AutomationProperties.Name="Remove rule" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="When" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox x:Name="ProcessName" Grid.Column="1" IsEditable="True" DropDownOpened="OnProcessListOpened"
                                  ToolTip="Program name, for example cs2.exe. Open the list to pick a running program."
                                  AutomationProperties.Name="Program name" />
                        <TextBlock Grid.Column="2" Text="runs, activate" VerticalAlignment="Center" Margin="12,0" />
                        <ComboBox x:Name="Mode" Grid.Column="3" MinWidth="150" DisplayMemberPath="Label" AutomationProperties.Name="Mode to activate" />
                        <ui:Button Grid.Column="4" Content="Add rule" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Margin="12,0,0,0" Click="OnAdd" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
        <TextBlock x:Name="Status" FontSize="12" Margin="4,10,0,0" Style="{StaticResource SecondaryTextStyle}" />

        <TextBlock Margin="4,16,0,0" FontSize="12" Style="{StaticResource SecondaryTextStyle}"
                   Text="Rules are checked from top to bottom: the first one whose program runs wins. A program is acted on once each time it starts, so undoing a mode by hand is respected. The protected list applies to automatic switches exactly as to manual ones." />
    </StackPanel>
</Page>
