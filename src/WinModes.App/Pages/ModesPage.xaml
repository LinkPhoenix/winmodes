<Page x:Class="WinModes.App.Pages.ModesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinModes.App.Localization"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Modes'}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <StackPanel Margin="36,24,36,36" MaxWidth="1100">

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{l:T 'Modes'}" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Text="{l:T 'No mode is active. Windows is in its normal state.'}"
                           Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button x:Name="UndoButton" Content="{l:T 'Undo active mode'}" Icon="{ui:SymbolIcon ArrowUndo24}"
                           Margin="0,0,8,0" Visibility="Collapsed" Click="OnUndoClick" />
                <ui:Button Content="{l:T 'Import mode'}" Icon="{ui:SymbolIcon ArrowDownload24}" Click="OnImportClick"
                           ToolTip="{l:T 'Add a mode from a profile file. It is checked against the protection list first.'}" />
            </StackPanel>
        </Grid>

        <Border x:Name="ResultCard" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ResultTitle" FontWeight="SemiBold" />
                <ItemsControl x:Name="ResultLines" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Mode cards -->
        <ItemsControl x:Name="ModeCards" Margin="0,0,-12,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Card" Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,0,12,12" MinHeight="270"
                            AutomationProperties.Name="{Binding AccessibleName}" ToolTip="{l:T 'Right-click to edit, export, duplicate or delete this mode'}">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:T 'Edit mode'}" Click="OnEditClick" />
                                <Separator />
                                <MenuItem Header="{l:T 'Export mode'}" Click="OnExportClick" />
                                <MenuItem Header="{l:T 'Duplicate mode'}" Click="OnDuplicateClick" />
                                <MenuItem Header="{l:T 'Delete mode'}" Click="OnDeleteClick" IsEnabled="{Binding CanDelete}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="5" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{Binding Accent}" CornerRadius="7,7,0,0" />
                            <Grid Grid.Row="1" Margin="20,18,20,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Width="52" Height="52" CornerRadius="12" HorizontalAlignment="Left" Background="{Binding Accent}">
                                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="26" Foreground="White"
                                               HorizontalAlignment="Center" Text="{Binding Glyph}" />
                                </Border>
                                <Border x:Name="SelectedPill" Style="{StaticResource ChipStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="Collapsed" Background="{Binding Accent}">
                                    <TextBlock Text="{Binding PillText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                </Border>

                                <TextBlock Grid.Row="1" Margin="0,14,0,0" Text="{Binding Label}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Margin="0,6,0,0" Text="{Binding Intent}" Style="{StaticResource SecondaryTextStyle}" />

                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="{Binding ChangeCount}" FontSize="20" FontWeight="SemiBold" Foreground="{Binding Accent}" />
                                    <TextBlock Text="{Binding ChangeCaption}" Style="{StaticResource SecondaryTextStyle}"
                                               VerticalAlignment="Bottom" Margin="6,0,0,2" />
                                </StackPanel>

                                <StackPanel Grid.Row="4" Margin="0,14,0,0" Orientation="Horizontal">
                                    <ui:Button Content="{Binding ActionText}" Margin="0,0,8,0" Padding="16,6" Foreground="White"
                                               Background="{Binding Accent}" MouseOverBackground="{Binding Accent}"
                                               IsEnabled="{Binding CanActivate}"
                                               Click="OnActivateClick" Tag="{Binding}" />
                                    <ui:Button Content="{l:T 'Preview'}" Padding="16,6" Click="OnPreviewClick" Tag="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{Binding Accent}" />
                            <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            <Setter TargetName="SelectedPill" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Preview of the selected mode -->
        <TextBlock x:Name="DetailTitle" Text="{l:T 'Choose a mode to see what it would change'}" FontSize="20" FontWeight="SemiBold"
                   Margin="0,32,0,0" />
        <TextBlock x:Name="DetailSummary" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,12"
                   Text="{l:T 'A preview compares the mode with the current state of this PC.'}" />

        <ItemsControl x:Name="ChangeGroups">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:CardExpander IsExpanded="{Binding IsExpanded, Mode=OneTime}" Margin="0,0,0,8" ContentPadding="0">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadgeStyle}" Background="{Binding Tint}">
                                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="17" HorizontalAlignment="Center"
                                               Foreground="{Binding Color}" Text="{Binding Glyph}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Style="{StaticResource ChipStyle}" Margin="0,0,16,0" Background="{Binding Tint}">
                                    <TextBlock Text="{Binding CountSummary}" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </ui:CardExpander.Header>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,10" MinHeight="54" BorderThickness="0,1,0,0"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            AutomationProperties.Name="{Binding AccessibleName}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Left" Background="{Binding Tint}">
                                                <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="12" HorizontalAlignment="Center"
                                                           Foreground="{Binding Color}" Text="{Binding Glyph}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Verb}" FontWeight="SemiBold" Foreground="{Binding Color}" />
                                                    <TextBlock Text="{Binding Target}" FontWeight="SemiBold" Margin="6,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Reason}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <Border Style="{StaticResource ChipStyle}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                    <TextBlock Text="{Binding From}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                                                </Border>
                                                <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="11" Margin="8,0" Text="&#xE76C;"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Border Style="{StaticResource ChipStyle}" Background="{Binding Tint}">
                                                    <TextBlock Text="{Binding To}" FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ui:CardExpander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
