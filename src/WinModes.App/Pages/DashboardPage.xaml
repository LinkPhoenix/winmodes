<Page x:Class="WinModes.App.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinModes.App.Localization"
      xmlns:app="clr-namespace:WinModes.App"
      xmlns:controls="clr-namespace:WinModes.App.Controls"
      Title="{l:T 'Dashboard'}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="36,24,36,36" MaxWidth="1100">

        <controls:PageHeader Title="{l:T 'Dashboard'}" Icon="Home24" Accent="{x:Static app:Palette.BrandBrush}">
            <TextBlock Text="{l:T 'Live state of this PC. Figures refresh every few seconds.'}"
                       Style="{StaticResource SecondaryTextStyle}" />
            <controls:PageHeader.Actions>
                <Border Style="{StaticResource ChipStyle}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ActiveModeDot" Width="8" Height="8" Fill="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="ActiveModeText" Text="{l:T 'Active mode: none'}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- AI tools at a glance -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{l:T 'AI TOOLS'}" Style="{StaticResource CardCaptionStyle}" />
                    <TextBlock x:Name="AiSummary" Text="{l:T 'Looking for AI tools…'}" FontSize="12" HorizontalAlignment="Right"
                               Style="{StaticResource SecondaryTextStyle}" />
                </Grid>
                <TextBlock x:Name="AiEmpty" Text="{l:T 'No AI or coding tool is running.'}" Margin="0,12,0,0" Visibility="Collapsed"
                           Style="{StaticResource SecondaryTextStyle}" />
                <ItemsControl x:Name="AiTools" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveCardGrid MinItemWidth="270" MaxColumns="3" Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Padding="12,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Click="OnAiToolClick" AutomationProperties.Name="{Binding AccessibleName}"
                                    ToolTip="{l:T 'Open the AI tools page'}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Width="28" Height="28" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="18" Text="&#xE99A;" Visibility="{Binding GlyphVisibility}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <Image Source="{Binding Icon}" Width="28" Height="28" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding MemoryText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding CpuText}" FontSize="12" HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Height="4" Margin="0,10,0,0" Minimum="0" Maximum="100"
                                                 Value="{Binding Share, Mode=OneWay}" Foreground="{Binding Color}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Vitals: gauge on the left, figures on the right, so the charts below stay in view. -->
        <controls:AdaptiveCardGrid MinItemWidth="300" MaxColumns="3" Spacing="12" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorderStyle}" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="100" Height="100">
                        <controls:RingGauge x:Name="CpuGauge" Thickness="8" Track="{DynamicResource ControlFillColorDefaultBrush}">
                            <controls:RingGauge.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C5CFC" Offset="0" />
                                    <GradientStop Color="#4F8BFF" Offset="1" />
                                </LinearGradientBrush>
                            </controls:RingGauge.Stroke>
                        </controls:RingGauge>
                        <TextBlock x:Name="CpuValue" Text="…" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CPU" Style="{StaticResource CardCaptionStyle}" />
                        <TextBlock Text="{l:T 'in use'}" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock x:Name="CpuDetail" FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="100" Height="100">
                        <controls:RingGauge x:Name="MemoryGauge" Thickness="8" Track="{DynamicResource ControlFillColorDefaultBrush}">
                            <controls:RingGauge.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F97316" Offset="0" />
                                    <GradientStop Color="#EC4899" Offset="1" />
                                </LinearGradientBrush>
                            </controls:RingGauge.Stroke>
                        </controls:RingGauge>
                        <TextBlock x:Name="MemoryValue" Text="…" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{l:T 'MEMORY'}" Style="{StaticResource CardCaptionStyle}" />
                        <TextBlock x:Name="MemoryDetail" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="MemoryFree" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Padding="18,16">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconBadgeStyle}" Width="28" Height="28" Background="#33C084FC">
                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="14" HorizontalAlignment="Center" Foreground="#C084FC" Text="&#xE71D;" />
                        </Border>
                        <TextBlock x:Name="ProcessValue" Text="…" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:T 'processes'}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Style="{StaticResource IconBadgeStyle}" Width="28" Height="28" Background="#3334D399">
                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="14" HorizontalAlignment="Center" Foreground="#34D399" Text="&#xE912;" />
                        </Border>
                        <TextBlock x:Name="ServiceValue" Text="…" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:T 'services running'}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Style="{StaticResource IconBadgeStyle}" Width="28" Height="28" Background="#3360A5FA">
                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="14" HorizontalAlignment="Center" Foreground="#60A5FA" Text="&#xE774;" />
                        </Border>
                        <TextBlock x:Name="NetworkValue" Text="…" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"
                                   ToolTip="{l:T 'Network, down and up'}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </controls:AdaptiveCardGrid>

        <!-- History, last 60 seconds -->
        <controls:AdaptiveCardGrid MinItemWidth="400" MaxColumns="2" Spacing="12" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{l:T 'CPU UTILIZATION'}" Style="{StaticResource CardCaptionStyle}" />
                        <TextBlock x:Name="CpuChartValue" Text="…" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#8B7CFF" />
                    </Grid>
                    <controls:SegmentBar x:Name="CpuBar" Height="16" Margin="0,10,0,10" Accent="#7C5CFC" />
                    <controls:HistoryChart x:Name="CpuChart" Height="170" Accent="#7C5CFC" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="{l:T '60 seconds'}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="CpuChartDetail" FontSize="12" HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                    <controls:CoreBars x:Name="CoreBars" Margin="0,8,0,0" Height="26" Accent="#7C5CFC" ToolTip="{l:T 'Load of each logical processor'}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{l:T 'MEMORY UTILIZATION'}" Style="{StaticResource CardCaptionStyle}" />
                        <TextBlock x:Name="MemoryChartValue" Text="…" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#F472B6" />
                    </Grid>
                    <controls:SegmentBar x:Name="MemoryBar" Height="16" Margin="0,10,0,10" Accent="#EC4899" />
                    <controls:HistoryChart x:Name="MemoryChart" Height="170" Accent="#EC4899" />
                    <UniformGrid Rows="1" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T 'In use'}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="MemoryInUse" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{l:T 'Available'}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="MemoryAvailable" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{l:T 'Committed'}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="MemoryCommitted" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{l:T 'Cached'}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="MemoryCached" FontWeight="SemiBold" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </controls:AdaptiveCardGrid>

        <!-- GPU and disk, same 60-second window. Each card hides itself when Windows has no counter for it. -->
        <controls:AdaptiveCardGrid x:Name="GpuDiskRow" MinItemWidth="400" MaxColumns="2" Spacing="12" Margin="0,0,0,12">
            <Border x:Name="GpuCard" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{l:T 'GPU UTILIZATION'}" Style="{StaticResource CardCaptionStyle}" />
                        <TextBlock x:Name="GpuChartValue" Text="…" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#34D399" />
                    </Grid>
                    <controls:HistoryChart x:Name="GpuChart" Height="110" Margin="0,10,0,0" Accent="#34D399" />
                    <TextBlock Text="{l:T 'Busiest GPU engine (3D, video, copy), all graphics cards'}" FontSize="12" Margin="0,8,0,0"
                               Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>
            <Border x:Name="DiskCard" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{l:T 'DISK ACTIVITY'}" Style="{StaticResource CardCaptionStyle}" />
                        <TextBlock x:Name="DiskChartValue" Text="…" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#FBBF24" />
                    </Grid>
                    <controls:HistoryChart x:Name="DiskChart" Height="110" Margin="0,10,0,0" Accent="#FBBF24" />
                    <TextBlock x:Name="DiskDetail" Text="{l:T 'All disks'}" FontSize="12" Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>
        </controls:AdaptiveCardGrid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Top memory consumers -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{l:T 'TOP MEMORY CONSUMERS'}" Style="{StaticResource CardCaptionStyle}" />
                        <TextBlock Text="{l:T 'private memory, grouped by app'}" FontSize="12" HorizontalAlignment="Right"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                    <ItemsControl x:Name="TopProcesses" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="20" Height="20" Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="14" Text="&#xECAA;" Visibility="{Binding GlyphVisibility}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                            <Image Source="{Binding Icon}" Width="20" Height="20" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="100" />
                                        <TextBlock Text="{Binding CountText}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ProgressBar Grid.Column="1" Height="6" Minimum="0" Maximum="100" Value="{Binding Share, Mode=OneWay}"
                                                 Foreground="{Binding Color}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding MemoryText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>


            <!-- Quick access to modes -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="{l:T 'MODES'}" Style="{StaticResource CardCaptionStyle}" />
                    <ItemsControl x:Name="QuickModes" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,6,0,0" Padding="12,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Click="OnModeClick" AutomationProperties.Name="{Binding Label}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="9" Background="{Binding Accent}">
                                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="18" Foreground="White"
                                                       HorizontalAlignment="Center" Text="{Binding Glyph}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource GlyphTextStyle}" FontSize="12" Text="&#xE76C;"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{l:T 'Open a mode to preview what it would change.'}" FontSize="12" Margin="0,14,0,0"
                               Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</Page>
