<Page x:Class="WinModes.App.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:WinModes.App.Controls"
      Title="Dashboard"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="36,24,36,36" MaxWidth="1100">

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Live state of this PC. Figures refresh every few seconds."
                           Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource ChipStyle}" VerticalAlignment="Top"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ActiveModeDot" Width="8" Height="8" Fill="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="ActiveModeText" Text="Active mode: none" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- AI tools at a glance -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <TextBlock Text="AI TOOLS" Style="{StaticResource CardCaptionStyle}" />
                    <TextBlock x:Name="AiSummary" Text="Looking for AI tools…" FontSize="12" HorizontalAlignment="Right"
                               Style="{StaticResource SecondaryTextStyle}" />
                </Grid>
                <TextBlock x:Name="AiEmpty" Text="No AI or coding tool is running." Margin="0,12,0,0" Visibility="Collapsed"
                           Style="{StaticResource SecondaryTextStyle}" />
                <ItemsControl x:Name="AiTools" Margin="0,12,-10,-10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="320" Margin="0,0,10,10" Padding="12,10" HorizontalContentAlignment="Stretch"
                                    Click="OnAiToolClick" AutomationProperties.Name="{Binding AccessibleName}"
                                    ToolTip="Open the AI tools page">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Width="28" Height="28" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="18" Text="&#xE99A;" Visibility="{Binding GlyphVisibility}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <Image Source="{Binding Icon}" Width="28" Height="28" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding MemoryText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding CpuText}" FontSize="12" HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Height="4" Margin="0,10,0,0" Minimum="0" Maximum="100"
                                                 Value="{Binding Share, Mode=OneWay}" Foreground="{Binding Color}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Vitals -->
        <UniformGrid Rows="1" Margin="0,0,-12,12">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="CPU" Style="{StaticResource CardCaptionStyle}" />
                    <Grid Width="150" Height="150" Margin="0,12,0,4">
                        <controls:RingGauge x:Name="CpuGauge" Thickness="9" Track="{DynamicResource ControlFillColorDefaultBrush}">
                            <controls:RingGauge.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C5CFC" Offset="0" />
                                    <GradientStop Color="#4F8BFF" Offset="1" />
                                </LinearGradientBrush>
                            </controls:RingGauge.Stroke>
                        </controls:RingGauge>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="CpuValue" Text="…" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="in use" FontSize="12" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="CpuDetail" FontSize="12" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="MEMORY" Style="{StaticResource CardCaptionStyle}" />
                    <Grid Width="150" Height="150" Margin="0,12,0,4">
                        <controls:RingGauge x:Name="MemoryGauge" Thickness="9" Track="{DynamicResource ControlFillColorDefaultBrush}">
                            <controls:RingGauge.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F97316" Offset="0" />
                                    <GradientStop Color="#EC4899" Offset="1" />
                                </LinearGradientBrush>
                            </controls:RingGauge.Stroke>
                        </controls:RingGauge>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="MemoryValue" Text="…" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="in use" FontSize="12" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="MemoryDetail" FontSize="12" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="BACKGROUND" Style="{StaticResource CardCaptionStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Border Style="{StaticResource IconBadgeStyle}" Background="#33C084FC">
                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="17" HorizontalAlignment="Center" Foreground="#C084FC" Text="&#xE71D;" />
                        </Border>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock x:Name="ProcessValue" Text="…" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="processes" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Border Style="{StaticResource IconBadgeStyle}" Background="#3334D399">
                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="17" HorizontalAlignment="Center" Foreground="#34D399" Text="&#xE912;" />
                        </Border>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock x:Name="ServiceValue" Text="…" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="services running" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- History, last 60 seconds -->
        <UniformGrid Rows="1" Margin="0,0,-12,12">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="CPU UTILIZATION" Style="{StaticResource CardCaptionStyle}" />
                        <TextBlock x:Name="CpuChartValue" Text="…" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#8B7CFF" />
                    </Grid>
                    <controls:SegmentBar x:Name="CpuBar" Height="16" Margin="0,10,0,10" Accent="#7C5CFC" />
                    <controls:HistoryChart x:Name="CpuChart" Height="170" Accent="#7C5CFC" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="60 seconds" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="CpuChartDetail" FontSize="12" HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="MEMORY UTILIZATION" Style="{StaticResource CardCaptionStyle}" />
                        <TextBlock x:Name="MemoryChartValue" Text="…" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#F472B6" />
                    </Grid>
                    <controls:SegmentBar x:Name="MemoryBar" Height="16" Margin="0,10,0,10" Accent="#EC4899" />
                    <controls:HistoryChart x:Name="MemoryChart" Height="170" Accent="#EC4899" />
                    <UniformGrid Rows="1" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="In use" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="MemoryInUse" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Available" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="MemoryAvailable" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Committed" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="MemoryCommitted" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Cached" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="MemoryCached" FontWeight="SemiBold" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Top memory consumers -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="TOP MEMORY CONSUMERS" Style="{StaticResource CardCaptionStyle}" />
                        <TextBlock Text="private memory, grouped by app" FontSize="12" HorizontalAlignment="Right"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                    <ItemsControl x:Name="TopProcesses" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="20" Height="20" Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="14" Text="&#xECAA;" Visibility="{Binding GlyphVisibility}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                            <Image Source="{Binding Icon}" Width="20" Height="20" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="100" />
                                        <TextBlock Text="{Binding CountText}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ProgressBar Grid.Column="1" Height="6" Minimum="0" Maximum="100" Value="{Binding Share, Mode=OneWay}"
                                                 Foreground="{Binding Color}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding MemoryText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>


            <!-- Quick access to modes -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="MODES" Style="{StaticResource CardCaptionStyle}" />
                    <ItemsControl x:Name="QuickModes" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,6,0,0" Padding="12,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Click="OnModeClick" AutomationProperties.Name="{Binding Label}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="9" Background="{Binding Accent}">
                                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="18" Foreground="White"
                                                       HorizontalAlignment="Center" Text="{Binding Glyph}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource GlyphTextStyle}" FontSize="12" Text="&#xE76C;"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Open a mode to preview what it would change." FontSize="12" Margin="0,14,0,0"
                               Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</Page>
