<Page x:Class="WinModes.App.Pages.UsagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinModes.App.Localization"
      xmlns:app="clr-namespace:WinModes.App"
      xmlns:controls="clr-namespace:WinModes.App.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Usage'}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="36,24,36,36" MaxWidth="1100">
        <controls:PageHeader Title="{l:T 'Usage'}" Icon="DataHistogram24" Accent="{x:Static app:Palette.Container}" Margin="0,0,0,0">
            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                       Text="{l:T 'What your AI tools used: tokens, and the memory they held per project.'}" />
            <controls:PageHeader.Actions>
                <ComboBox x:Name="Period" MinWidth="150" DisplayMemberPath="Label"
                          SelectionChanged="OnPeriodChanged" AutomationProperties.Name="{l:T 'Period'}" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <TextBlock Text="{l:T 'TOKENS'}" Style="{StaticResource CardCaptionStyle}" Margin="4,22,0,8" />
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <StackPanel Margin="0,0,80,0">
                    <TextBlock Text="{l:T 'Count the tokens used'}" FontWeight="SemiBold" />
                    <TextBlock FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                               Text="{l:T 'Off by default. Reads the usage figures that Claude Code and Codex write in their logs on this PC: the number of tokens, the model, the date and the name of the project folder. The text of your conversations is never kept or shown, and nothing leaves this PC.'}" />
                    <TextBlock x:Name="TokenStatus" FontSize="12" Margin="0,6,0,0" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <ui:ToggleSwitch x:Name="TokensEnabled" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Checked="OnTokensChanged" Unchecked="OnTokensChanged" AutomationProperties.Name="{l:T 'Count the tokens used'}" />
            </Grid>
        </Border>
        <ContentControl x:Name="TokenHost" Margin="0,0,0,4" />
        <TextBlock x:Name="TokenEmpty" Visibility="Collapsed" Style="{StaticResource SecondaryTextStyle}" Margin="4,0,0,12"
                   Text="{l:T 'No tokens found in the logs for this period.'}" />

        <TextBlock Text="{l:T 'MEMORY'}" Style="{StaticResource CardCaptionStyle}" Margin="4,14,0,8" />
        <TextBlock x:Name="Summary" Style="{StaticResource SecondaryTextStyle}" Margin="4,0,0,10"
                   Text="{l:T 'How much memory your AI tools used, per project.'}" />
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <StackPanel Margin="0,0,220,0">
                    <TextBlock Text="{l:T 'Record usage history'}" FontWeight="SemiBold" />
                    <TextBlock FontSize="12" Style="{StaticResource SecondaryTextStyle}"
                               Text="{l:T 'Off by default. When on, WinModes samples your AI tools in the background and keeps daily totals for 30 days, on this PC only. Nothing is sent anywhere.'}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button Content="{l:T 'Clear history'}" Icon="{ui:SymbolIcon Delete24}" Margin="0,0,14,0" Click="OnClear" />
                    <ui:ToggleSwitch x:Name="Enabled" Checked="OnEnabledChanged" Unchecked="OnEnabledChanged"
                                     AutomationProperties.Name="{l:T 'Record usage history'}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="EmptyState" Style="{StaticResource CardBorderStyle}" Padding="32">
            <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="DataHistogram24" FontSize="40" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="EmptyTitle" Text="{l:T 'Nothing recorded yet'}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border x:Name="ListCard" Style="{StaticResource CardBorderStyle}" Padding="0" Visibility="Collapsed">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="20,12" BorderThickness="0,0,0,1" BorderBrush="{StaticResource AppCardStrokeBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Project}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Tool}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <Grid Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Height="8">
                                    <Border CornerRadius="4" Background="{StaticResource AppCardStrokeBrush}" />
                                    <ProgressBar Value="{Binding Share, Mode=OneWay}" Maximum="100" Height="8" Foreground="{Binding Color}"
                                                 Background="Transparent" BorderThickness="0" />
                                </Grid>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Duration}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Text="{l:T 'active'}" FontSize="12" HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Average}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Text="{l:T 'average'}" FontSize="12" HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Peak}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Text="{l:T 'peak'}" FontSize="12" HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</Page>
