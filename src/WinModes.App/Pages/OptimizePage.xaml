<Page x:Class="WinModes.App.Pages.OptimizePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinModes.App.Localization"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Optimize'}"
      ScrollViewer.CanContentScroll="False"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="PillStyle" TargetType="Border" BasedOn="{StaticResource ChipStyle}">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="0,6,6,0" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        </Style>

        <!-- The arrow that opens the list of changes of a setting. -->
        <Style x:Key="DetailsToggleStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="6" Background="Transparent">
                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="12" Text="{Binding ChevronGlyph}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One change of a setting: a tick box when there is a choice, the plain-words label, and the registry value or task behind it. -->
        <DataTemplate x:Key="PartTemplate">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" Visibility="{Binding ChoiceVisibility}"
                          MinWidth="0" Margin="0,0,10,0" VerticalAlignment="Top" Click="OnRowToggled" ToolTip="{Binding ToggleTip}"
                          ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Label}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Label}" FontSize="13" TextWrapping="Wrap" Visibility="{Binding ChoiceVisibility}" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                               ToolTip="{Binding Detail}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Top"
                           Foreground="{Binding StatusBrush}" />
            </Grid>
        </DataTemplate>

        <!-- The details of a setting, built only while it is open. -->
        <DataTemplate x:Key="DetailsTemplate">
            <Border Margin="46,12,0,0" Padding="14,10,14,12" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="{l:T 'What this changes'}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="{Binding ChoiceHint}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding ChoiceHintVisibility}"
                               Style="{StaticResource SecondaryTextStyle}" />
                    <ItemsControl ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource PartTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A category of the bar: a button whose colours follow the selection (set by the code, since they differ per category). -->
        <Style x:Key="CategoryChipStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" CornerRadius="16" Padding="12,6" Margin="0,0,8,8" BorderThickness="1"
                                Background="{Binding Fill}" BorderBrush="{Binding Stroke}" Opacity="{Binding Emphasis}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="13" Margin="0,0,8,0" Text="{Binding Glyph}" Foreground="{Binding Color}" />
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Count}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- The page scrolls its list itself (the shell's scrolling is off) so the category bar and the review bar stay in view. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="36,24,36,4" MaxWidth="1100">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:T 'Optimize'}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBox x:Name="SearchBox" PlaceholderText="{l:T 'Search settings'}" Icon="{ui:SymbolIcon Search24}" Width="300"
                                TextChanged="OnFilterChanged" AutomationProperties.Name="{l:T 'Search settings'}" />
                    <CheckBox x:Name="HideApplied" Content="{l:T 'Hide what is already applied'}" Margin="16,0,0,0"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                </StackPanel>
            </Grid>
            <ItemsControl x:Name="CategoryBar" Margin="0,14,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CategoryChipStyle}" Click="OnCategoryClick" AutomationProperties.Name="{Binding Title}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ScrollViewer x:Name="ListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,4,36,24" MaxWidth="1100">
                <TextBlock Text="{l:T 'Windows settings worth changing, checked against this PC. Switch on what you want, review, then apply.'}"
                           Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,16" TextWrapping="Wrap" />

                <!-- Where this PC stands -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ScoreValue" Text="…" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock x:Name="ScoreLabel" Text="{l:T 'recommended settings applied'}" Margin="10,0,0,4" VerticalAlignment="Bottom"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <ProgressBar x:Name="ScoreBar" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100" Foreground="#34D399" />
                            <TextBlock x:Name="Summary" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                            <ui:Button x:Name="SelectRecommendedButton" Content="{l:T 'Switch on the recommended ones'}" Icon="{ui:SymbolIcon Sparkle24}"
                                       Appearance="Primary" HorizontalAlignment="Stretch" Click="OnSelectRecommended" />
                            <ui:Button x:Name="UndoAllButton" Content="{l:T 'Undo everything WinModes changed'}" Icon="{ui:SymbolIcon ArrowUndo24}"
                                       Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="OnUndoAll" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="ResultCard" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="16" Text="&#xE946;" Margin="0,2,12,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ResultText" Grid.Column="1" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <TextBlock x:Name="EmptyText" Text="{l:T 'Nothing matches.'}" Margin="4,16,0,0" Visibility="Collapsed" Style="{StaticResource SecondaryTextStyle}" />

                <!-- One card per category -->
                <ItemsControl x:Name="Groups">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid Margin="20,14,20,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBadgeStyle}" Width="32" Height="32" Background="{Binding Tint}">
                                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="15" HorizontalAlignment="Center"
                                                       Foreground="{Binding Color}" Text="{Binding Glyph}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0" Width="130">
                                            <TextBlock Text="{Binding Progress}" FontSize="12" HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" />
                                            <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                         Foreground="{Binding Color}" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="20,12" MinHeight="56" BorderThickness="0,1,0,0" BorderBrush="{StaticResource AppCardStrokeBrush}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Scope: who is affected, and whether Windows will ask for permission. -->
                                                        <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="16" Text="{Binding ScopeGlyph}"
                                                                   Width="32" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding ScopeTip}"
                                                                   Background="Transparent" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                                <Run Text="{Binding Subtitle, Mode=OneWay}" FontSize="12"
                                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Description}" FontSize="12" Style="{StaticResource SecondaryTextStyle}"
                                                                       TextWrapping="Wrap" MaxHeight="50" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                                                            <TextBlock Text="{Binding Warning}" FontSize="12" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                       Visibility="{Binding WarningVisibility}" />
                                                            <WrapPanel>
                                                                <Border Style="{StaticResource PillStyle}" Background="{Binding NoteTint}" ToolTip="{Binding NoteTip}">
                                                                    <TextBlock Text="{Binding Note}" FontSize="11" FontWeight="SemiBold" />
                                                                </Border>
                                                                <Border Style="{StaticResource PillStyle}" Visibility="{Binding ToolsVisibility}" ToolTip="{Binding ToolsTip}">
                                                                    <TextBlock Text="{Binding Tools}" FontSize="11" />
                                                                </Border>
                                                                <Border Style="{StaticResource PillStyle}" Visibility="{Binding ChangeVisibility}">
                                                                    <TextBlock Text="{Binding Change}" FontSize="11" />
                                                                </Border>
                                                                <Border Style="{StaticResource PillStyle}" Visibility="{Binding RestartVisibility}" ToolTip="{Binding RestartTip}">
                                                                    <TextBlock Text="{Binding Restart}" FontSize="11" />
                                                                </Border>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Margin="16,0,14,0" Foreground="{Binding StatusBrush}" />
                                                        <ui:ToggleSwitch Grid.Column="3" IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"
                                                                         VerticalAlignment="Center" Click="OnRowToggled" ToolTip="{Binding ToggleTip}"
                                                                         ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Title}" />
                                                        <Button Grid.Column="4" Style="{StaticResource DetailsToggleStyle}" Click="OnToggleDetails"
                                                                Visibility="{Binding ExpanderVisibility}" ToolTip="{Binding ExpanderTip}"
                                                                AutomationProperties.Name="{Binding ExpanderTip}" />
                                                        <ContentControl Grid.Row="1" Grid.ColumnSpan="5" Content="{Binding Details}" ContentTemplate="{StaticResource DetailsTemplate}"
                                                                        Visibility="{Binding DetailsVisibility}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{l:T 'WinModes reads the current value of every setting and records it before changing it; switching a setting off puts the recorded value back. Nothing is uninstalled or deleted, and settings that weaken security or Windows Update are not offered.'}"
                           FontSize="12" Margin="4,16,4,0" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Review bar: nothing changes until Apply. -->
        <Border x:Name="ReviewBar" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource AppCardBrush}"
                BorderBrush="{DynamicResource AppCardStrokeBrush}" BorderThickness="0,1,0,0" Padding="36,12">
            <Grid MaxWidth="1100">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconBadgeStyle}" Width="32" Height="32" Background="#337C5CFC">
                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="15" HorizontalAlignment="Center" Foreground="#A78BFA" Text="&#xE8FD;" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ReviewTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="ReviewDetail" FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <CheckBox x:Name="StopNow" Content="{l:T 'Stop the services now'}" Margin="0,0,8,0" Visibility="Collapsed"
                              ToolTip="{l:T 'Off: the change takes effect the next time Windows starts. On: running services are stopped right away, unless another service needs them.'}" />
                    <ui:Button Content="{l:T 'Discard'}" Click="OnDiscard" />
                    <ui:Button x:Name="ApplyButton" Content="{l:T 'Apply'}" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary" Margin="8,0,0,0" Click="OnApply" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
