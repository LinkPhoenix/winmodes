<Page x:Class="WinModes.App.Pages.OptimizePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinModes.App.Localization"
      xmlns:app="clr-namespace:WinModes.App"
      xmlns:controls="clr-namespace:WinModes.App.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      PreviewKeyDown="OnPreviewKeyDown"
      Title="{l:T 'Optimize'}"
      ScrollViewer.CanContentScroll="False"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="PillStyle" TargetType="Border" BasedOn="{StaticResource ChipStyle}">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="0,6,6,0" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        </Style>

        <!-- The arrow that opens the list of changes of a setting. -->
        <Style x:Key="DetailsToggleStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="6" Background="Transparent" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="12" Text="{Binding ChevronGlyph}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One change of a setting: a tick box when there is a choice, the plain-words label, and the registry value or task behind it. -->
        <DataTemplate x:Key="PartTemplate">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" Visibility="{Binding ChoiceVisibility}"
                          MinWidth="0" Margin="0,0,10,0" VerticalAlignment="Top" Click="OnRowToggled" ToolTip="{Binding ToggleTip}"
                          ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Label}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Label}" FontSize="13" TextWrapping="Wrap" Visibility="{Binding ChoiceVisibility}" />
                    <TextBlock Text="{Binding Observation}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ToggleTip}" Visibility="{Binding BlockedVisibility}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                               ToolTip="{Binding Detail}" />
                </StackPanel>
                <controls:StatusBadge Grid.Column="2" Text="{Binding Status}" Glyph="{Binding StatusGlyph}" Tone="{Binding StatusBrush}"
                                      Margin="16,0,0,0" VerticalAlignment="Top" />
            </Grid>
        </DataTemplate>

        <!-- The details of a setting, built only while it is open. -->
        <DataTemplate x:Key="DetailsTemplate">
            <Border Margin="46,12,0,0" Padding="14,10,14,12" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="{l:T 'What this changes'}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="{Binding ScopeTip}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding ToolsTip}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding ToolsVisibility}" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="{Binding ChoiceHint}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding ChoiceHintVisibility}"
                               Style="{StaticResource SecondaryTextStyle}" />
                    <ItemsControl ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource PartTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- A row of the flat list: the card of its category is drawn by the frame, since a virtualized list cannot nest the rows in a card. -->
        <DataTemplate x:Key="RowTemplate">
            <Border MaxWidth="1100" Margin="36,0" Background="{DynamicResource AppCardBrush}" BorderBrush="{StaticResource AppCardStrokeBrush}"
                    BorderThickness="{Binding Frame}" CornerRadius="{Binding Corners}">
                    <Border Padding="20,12" MinHeight="56" BorderThickness="0,1,0,0" BorderBrush="{StaticResource AppCardStrokeBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Scope: who is affected, and whether Windows will ask for permission. -->
                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="16" Text="{Binding ScopeGlyph}"
                                       Width="32" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding ScopeTip}"
                                       Background="Transparent" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Subtitle, Mode=OneWay}" FontSize="12"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Description}" FontSize="13" Style="{StaticResource SecondaryTextStyle}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding Warning}" FontSize="12" Foreground="{x:Static app:Palette.Power}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding WarningVisibility}" />
                                <WrapPanel>
                                    <controls:StatusBadge Text="{Binding Note}" Glyph="{Binding NoteGlyph}" Tone="{Binding NoteTone}"
                                                          ToolTip="{Binding NoteTip}" Margin="0,6,6,0" />
                                    <controls:StatusBadge Text="{l:T 'Check first'}" Glyph="&#xE7BA;" Tone="{x:Static app:Palette.Power}"
                                                          Visibility="{Binding CautionVisibility}" Margin="0,6,6,0"
                                                          ToolTip="{l:T 'Read the consequences before choosing this setting.'}" />
                                    <controls:StatusBadge Text="{Binding Status}" Glyph="{Binding StatusGlyph}" Tone="{Binding StatusBrush}"
                                                          Margin="0,6,6,0" />
                                    <controls:StatusBadge Text="{Binding ScopeLabel}" Glyph="{Binding ScopeGlyph}" Tone="{x:Static app:Palette.Neutral}"
                                                          ToolTip="{Binding ScopeTip}" Margin="0,6,6,0" />
                                    <controls:StatusBadge Text="{l:T 'Policy value present'}" Glyph="&#xE72E;" Tone="{x:Static app:Palette.Power}"
                                                          Visibility="{Binding PolicyVisibility}" Margin="0,6,6,0"
                                                          ToolTip="{l:T 'A registry policy value is present. Its effect depends on the Windows edition and build.'}" />
                                    <Border Style="{StaticResource PillStyle}" Visibility="{Binding ChangeVisibility}">
                                        <TextBlock Text="{Binding Change}" FontSize="11" />
                                    </Border>
                                    <Border Style="{StaticResource PillStyle}" Visibility="{Binding RestartVisibility}" ToolTip="{Binding RestartTip}">
                                        <TextBlock Text="{Binding Restart}" FontSize="11" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="3" IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"
                                             VerticalAlignment="Center" Margin="16,0,0,0" Click="OnRowToggled" ToolTip="{Binding ToggleTip}"
                                             AutomationProperties.HelpText="{Binding SelectionHelp}"
                                             ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Title}" />
                            <Button Grid.Column="4" Style="{StaticResource DetailsToggleStyle}" Click="OnToggleDetails"
                                    Visibility="{Binding ExpanderVisibility}" ToolTip="{Binding ExpanderTip}"
                                    AutomationProperties.Name="{Binding ExpanderTip}" />
                            <ContentControl Grid.Row="1" Grid.ColumnSpan="5" Content="{Binding Details}" ContentTemplate="{StaticResource DetailsTemplate}"
                                            Visibility="{Binding DetailsVisibility}" />
                        </Grid>
                    </Border>
            </Border>
        </DataTemplate>

        <!-- The title of a category: the top of its card. -->
        <DataTemplate x:Key="GroupTemplate">
            <Border MaxWidth="1100" Margin="36,12,36,0" Background="{DynamicResource AppCardBrush}" BorderBrush="{StaticResource AppCardStrokeBrush}"
                    BorderThickness="1,1,1,0" CornerRadius="10,10,0,0">
                    <Grid Margin="20,14,20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconBadgeStyle}" Width="32" Height="32" Background="{Binding Tint}">
                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="15" HorizontalAlignment="Center"
                                       Foreground="{Binding Color}" Text="{Binding Glyph}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0" Width="130">
                            <TextBlock Text="{Binding Progress}" FontSize="12" HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" />
                            <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                         Foreground="{Binding Color}" />
                        </StackPanel>
                    </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="IntroTemplate">
            <Border MaxWidth="1100" Margin="36,4,36,12" Padding="16,12" CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="{l:T '1. Choose   →   2. Review   →   3. Apply'}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{l:T 'Switches prepare your choices. Windows changes only after you review and confirm.'}"
                               Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Where this PC stands -->
        <DataTemplate x:Key="ScoreTemplate">
            <Border MaxWidth="1100" Margin="36,0,36,12" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:T 'A simple starting point'}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
                            <Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="{l:T 'recommended settings already applied'}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                        <WrapPanel Margin="0,8,0,0">
                            <controls:StatusBadge Text="{l:T 'Recommended'}" Glyph="&#xE73E;" Tone="{x:Static app:Palette.Start}" Margin="0,0,8,4" />
                            <controls:StatusBadge Text="{l:T 'Optional'}" Glyph="&#xE946;" Tone="{x:Static app:Palette.Container}" Margin="0,0,8,4" />
                            <controls:StatusBadge Text="{l:T 'Check first'}" Glyph="&#xE7BA;" Tone="{x:Static app:Palette.Power}" Margin="0,0,8,4" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                        <ui:Button Content="{l:T 'Prepare recommended settings'}" Icon="{ui:SymbolIcon Sparkle24}" IsEnabled="{Binding CanSelectRecommended}"
                                   Appearance="Primary" HorizontalAlignment="Stretch" Click="OnSelectRecommended"
                                   ToolTip="{l:T 'Prepares readable, low-risk recommendations without warnings. Services remain an individual choice. Nothing is applied yet.'}" />
                        <TextBlock Text="{l:T 'No warnings in this selection. Choose services individually.'}" FontSize="12" MaxWidth="330"
                                   TextWrapping="Wrap" Margin="0,6,0,0" Style="{StaticResource SecondaryTextStyle}" />
                        <ui:Button Content="{l:T 'Undo everything WinModes changed'}" Icon="{ui:SymbolIcon ArrowUndo24}" IsEnabled="{Binding CanUndoAll}"
                                   Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="OnUndoAll" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ResultTemplate">
            <Border MaxWidth="1100" Margin="36,0,36,12" Style="{StaticResource CardBorderStyle}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="16" Text="&#xE946;" Margin="0,2,12,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding Requirements}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <ItemsControl ItemsSource="{Binding Results}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,6,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EmptyTemplate">
            <controls:EmptyState Glyph="&#xE721;" Title="{l:T 'Nothing matches.'}"
                                 Hint="{l:T 'Try another search or clear filters.'}" MaxWidth="1100" HorizontalAlignment="Stretch" />
        </DataTemplate>

        <DataTemplate x:Key="FooterTemplate">
            <TextBlock MaxWidth="1100" Margin="40,16,40,24" FontSize="12" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                       Text="{l:T 'WinModes reads the current value of every setting and records it before changing it; switching a setting off puts the recorded value back. Nothing is uninstalled or deleted, and settings that weaken security or Windows Update are not offered.'}" />
        </DataTemplate>
    </Page.Resources>

    <!-- The page scrolls its list itself (the shell's scrolling is off) so the category bar and the review bar stay in view. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="36,24,36,4" MaxWidth="1100">
            <controls:PageHeader Title="{l:T 'Optimize'}" Icon="Wand24" Accent="{x:Static app:Palette.BrandBrush}" Margin="0">
                <TextBlock Text="{l:T 'Less distraction. Settings that fit the way you use Windows.'}" TextWrapping="Wrap" />
            </controls:PageHeader>
            <WrapPanel Margin="0,12,0,0">
                <controls:SearchField x:Name="SearchBox" PlaceholderText="{l:T 'Search settings'}" Width="300" Margin="0,0,16,8"
                                      TextChanged="OnSearchChanged" AutomationProperties.Name="{l:T 'Search settings'}" />
                <CheckBox x:Name="HideApplied" Content="{l:T 'Hide what is already applied'}" Margin="0,0,0,8" VerticalAlignment="Center"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                <ui:Button Content="{l:T 'Clear filters'}" Margin="16,0,0,8" Click="OnClearFilters" />
                <ui:Button Content="{l:T 'Policies and recovery'}" Icon="{ui:SymbolIcon ShieldCheckmark24}" Margin="12,0,0,8" Click="OnPolicyRecovery" />
            </WrapPanel>
            <WrapPanel Margin="0,12,0,0">
                <ui:Button x:Name="RefreshButton" Content="{l:T 'Refresh'}" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefresh" Margin="0,0,12,0" ToolTip="F5"/>
                <TextBlock x:Name="ObservationStatus" Text="{l:T 'Checking settings…'}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="{l:T 'Show'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="SettingFilter" Width="190" SelectedIndex="1" SelectionChanged="OnSettingFilterChanged" AutomationProperties.Name="{l:T 'Filter settings'}">
                    <ComboBoxItem Content="{l:T 'All'}" />
                    <ComboBoxItem Content="{l:T 'Recommended'}" />
                    <ComboBoxItem Content="{l:T 'Check first'}" />
                    <ComboBoxItem Content="{l:T 'Already applied'}" />
                    <ComboBoxItem Content="{l:T 'Administrator required'}" />
                    <ComboBoxItem Content="{l:T 'Pending changes'}" />
                    <ComboBoxItem Content="{l:T 'Unavailable or unreadable'}" />
                    <ComboBoxItem Content="{l:T 'Policy values present'}" />
                    <ComboBoxItem Content="{l:T 'Settings with a disabled switch'}" />
                </ComboBox>
                <TextBlock x:Name="VisibleCount" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="20,0,0,0" />
            </WrapPanel>
            <ItemsControl x:Name="CategoryBar" Margin="0,14,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CategoryChipStyle}" Click="OnCategoryClick" AutomationProperties.Name="{Binding Title}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- One flat list (intro, score, a title and the rows of each category, footer): only the rows in view are built. -->
        <ItemsControl x:Name="Items" Grid.Row="1" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer x:Name="ListScroll" Focusable="False" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- Review bar: nothing changes until Apply. -->
        <Border x:Name="ReviewBar" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource AppCardBrush}"
                BorderBrush="{DynamicResource AppCardStrokeBrush}" BorderThickness="0,1,0,0" Padding="36,12">
            <Grid MaxWidth="1100">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconBadgeStyle}" Width="32" Height="32" Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="15" HorizontalAlignment="Center" Foreground="{x:Static app:Palette.Apps}" Text="&#xE8FD;" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ReviewTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="ReviewDetail" FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <CheckBox x:Name="StopNow" Content="{l:T 'Stop the services now'}" Margin="0,0,8,0" Visibility="Collapsed"
                              ToolTip="{l:T 'Off: the change takes effect the next time Windows starts. On: running services are stopped right away, unless another service needs them.'}" />
                    <ui:Button Content="{l:T 'Discard'}" Click="OnDiscard" />
                    <ui:Button x:Name="ApplyButton" Content="{l:T 'Review changes'}" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary" Margin="8,0,0,0" Click="OnApply" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
