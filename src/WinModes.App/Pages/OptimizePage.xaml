<Page x:Class="WinModes.App.Pages.OptimizePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Optimize"
      ScrollViewer.CanContentScroll="False"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="PillStyle" TargetType="Border" BasedOn="{StaticResource ChipStyle}">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="0,6,6,0" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <!-- The page scrolls its list itself (the shell's scrolling is off) so the review bar stays in view. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,24,36,24" MaxWidth="1100">
                <TextBlock Text="Optimize" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Windows settings worth changing, checked against this PC. Switch on what you want, review, then apply."
                           Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,16" TextWrapping="Wrap" />

                <!-- Where this PC stands -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ScoreValue" Text="…" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock x:Name="ScoreLabel" Text="recommended settings applied" Margin="10,0,0,4" VerticalAlignment="Bottom"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <ProgressBar x:Name="ScoreBar" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100" Foreground="#34D399" />
                            <TextBlock x:Name="Summary" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                            <ui:Button x:Name="SelectRecommendedButton" Content="Switch on the recommended ones" Icon="{ui:SymbolIcon Sparkle24}"
                                       Appearance="Primary" HorizontalAlignment="Stretch" Click="OnSelectRecommended" />
                            <ui:Button x:Name="UndoAllButton" Content="Undo everything WinModes changed" Icon="{ui:SymbolIcon ArrowUndo24}"
                                       Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="OnUndoAll" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="ResultCard" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="16" Text="&#xE946;" Margin="0,2,12,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ResultText" Grid.Column="1" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Grid Margin="4,4,0,4">
                    <ui:TextBox x:Name="SearchBox" PlaceholderText="Search settings" Icon="{ui:SymbolIcon Search24}" Width="320"
                                HorizontalAlignment="Left" TextChanged="OnFilterChanged" AutomationProperties.Name="Search settings" />
                    <CheckBox x:Name="HideApplied" Content="Hide what is already applied" HorizontalAlignment="Right"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                </Grid>

                <TextBlock x:Name="EmptyText" Text="Nothing matches." Margin="4,16,0,0" Visibility="Collapsed" Style="{StaticResource SecondaryTextStyle}" />

                <!-- One card per category -->
                <ItemsControl x:Name="Groups">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid Margin="20,14,20,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBadgeStyle}" Width="32" Height="32" Background="{Binding Tint}">
                                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="15" HorizontalAlignment="Center"
                                                       Foreground="{Binding Color}" Text="{Binding Glyph}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0" Width="130">
                                            <TextBlock Text="{Binding Progress}" FontSize="12" HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" />
                                            <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                         Foreground="{Binding Color}" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="20,12" MinHeight="56" BorderThickness="0,1,0,0" BorderBrush="{StaticResource AppCardStrokeBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Scope: who is affected, and whether Windows will ask for permission. -->
                                                        <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="16" Text="{Binding ScopeGlyph}"
                                                                   Width="32" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding ScopeTip}"
                                                                   Background="Transparent" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                                <Run Text="{Binding Subtitle, Mode=OneWay}" FontSize="12"
                                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Description}" FontSize="12" Style="{StaticResource SecondaryTextStyle}"
                                                                       TextWrapping="Wrap" MaxHeight="50" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                                                            <TextBlock Text="{Binding Warning}" FontSize="12" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                       Visibility="{Binding WarningVisibility}" />
                                                            <WrapPanel>
                                                                <Border Style="{StaticResource PillStyle}" Background="{Binding NoteTint}" ToolTip="{Binding NoteTip}">
                                                                    <TextBlock Text="{Binding Note}" FontSize="11" FontWeight="SemiBold" />
                                                                </Border>
                                                                <Border Style="{StaticResource PillStyle}" Visibility="{Binding ToolsVisibility}" ToolTip="{Binding ToolsTip}">
                                                                    <TextBlock Text="{Binding Tools}" FontSize="11" />
                                                                </Border>
                                                                <Border Style="{StaticResource PillStyle}" Visibility="{Binding ChangeVisibility}">
                                                                    <TextBlock Text="{Binding Change}" FontSize="11" />
                                                                </Border>
                                                                <Border Style="{StaticResource PillStyle}" Visibility="{Binding RestartVisibility}" ToolTip="{Binding RestartTip}">
                                                                    <TextBlock Text="{Binding Restart}" FontSize="11" />
                                                                </Border>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Margin="16,0,14,0" Foreground="{Binding StatusBrush}" />
                                                        <ui:ToggleSwitch Grid.Column="3" IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"
                                                                         VerticalAlignment="Center" Click="OnRowToggled" ToolTip="{Binding ToggleTip}"
                                                                         ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Title}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="WinModes reads the current value of every setting and records it before changing it; switching a setting off puts the recorded value back. Nothing is uninstalled or deleted, and settings that weaken security or Windows Update are not offered."
                           FontSize="12" Margin="4,16,4,0" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Review bar: nothing changes until Apply. -->
        <Border x:Name="ReviewBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource AppCardBrush}"
                BorderBrush="{DynamicResource AppCardStrokeBrush}" BorderThickness="0,1,0,0" Padding="36,12">
            <Grid MaxWidth="1100">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconBadgeStyle}" Width="32" Height="32" Background="#337C5CFC">
                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="15" HorizontalAlignment="Center" Foreground="#A78BFA" Text="&#xE8FD;" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ReviewTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="ReviewDetail" FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <CheckBox x:Name="StopNow" Content="Stop the services now" Margin="0,0,8,0" Visibility="Collapsed"
                              ToolTip="Off: the change takes effect the next time Windows starts. On: running services are stopped right away, unless another service needs them." />
                    <ui:Button Content="Discard" Click="OnDiscard" />
                    <ui:Button x:Name="ApplyButton" Content="Apply" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary" Margin="8,0,0,0" Click="OnApply" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
