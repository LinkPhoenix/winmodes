<Page x:Class="WinModes.App.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="About"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="36,24,36,36" MaxWidth="1100">
        <TextBlock Text="About" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="Reversible Windows 11 modes for coding, work and gaming." Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,24" />

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="14" HorizontalAlignment="Left">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7C5CFC" Offset="0" />
                            <GradientStop Color="#EC4899" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="26" Foreground="White" HorizontalAlignment="Center" Text="&#xE945;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="WinModes" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconBadgeStyle}" Background="#3334D399">
                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="17" HorizontalAlignment="Center" Foreground="#34D399" Text="&#xE895;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Updates" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateText" FontSize="12" Style="{StaticResource SecondaryTextStyle}"
                               Text="WinModes can ask GitHub whether a newer release exists. Nothing is downloaded or installed by itself." />
                    <CheckBox x:Name="CheckAtStartup" Content="Check once when WinModes starts" Margin="0,6,0,0"
                              Checked="OnCheckAtStartupChanged" Unchecked="OnCheckAtStartupChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="CheckButton" Content="Check now" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnCheckUpdates" />
                    <ui:Button x:Name="DownloadButton" Content="Open release page" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary"
                               Margin="8,0,0,0" Visibility="Collapsed" Click="OnOpenRelease" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconBadgeStyle}" Background="#33FBBF24">
                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="17" HorizontalAlignment="Center" Foreground="#FBBF24" Text="&#xEB51;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Support the project" FontWeight="SemiBold" />
                    <TextBlock Text="WinModes is free for noncommercial use. If it helps you, you can buy the author a coffee."
                               FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Welcome guide" Icon="{ui:SymbolIcon Lightbulb24}" Margin="0,0,8,0" Click="OnShowGuide" />
                    <ui:Button Content="Source code" Icon="{ui:SymbolIcon Code24}" Margin="0,0,8,0" Click="OnOpenSource" />
                    <ui:Button Content="Buy me a coffee" Icon="{ui:SymbolIcon DrinkCoffee24}" Appearance="Primary" Click="OnBuyCoffee" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="SYSTEM" Style="{StaticResource CardCaptionStyle}" />
                <ItemsControl x:Name="SystemRows" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Key}" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="BUILT WITH" Style="{StaticResource CardCaptionStyle}" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                           Text=".NET 10 and WPF (Microsoft, MIT licence). WPF-UI 4.3 by lepo.co (MIT licence). Icons: Segoe Fluent Icons, shipped with Windows 11." />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}"
                           Text="Graph style inspired by Task Manager TMOG and the layout by OMEN Gaming Hub; no code or assets from either product are used." />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
