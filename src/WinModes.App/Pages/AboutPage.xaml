<Page x:Class="WinModes.App.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinModes.App.Localization"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'About'}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="36,24,36,36" MaxWidth="1100">
        <TextBlock Text="{l:T 'About'}" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="{l:T 'Reversible Windows 11 modes for coding, work and gaming.'}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,24" />

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="14" HorizontalAlignment="Left">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7C5CFC" Offset="0" />
                            <GradientStop Color="#EC4899" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="26" Foreground="White" HorizontalAlignment="Center" Text="&#xE945;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="WinModes" FontSize="20" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                        <Border x:Name="BetaBadge" Visibility="Collapsed" CornerRadius="9" Padding="7,1,7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="BetaBadgeText" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="BetaNote" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Style="{StaticResource SecondaryTextStyle}"
                               Text="{l:T 'This is a beta build for testing: it may still contain mistakes. It follows the beta releases and moves to the stable version when it comes out.'}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconBadgeStyle}" Background="#3334D399">
                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="17" HorizontalAlignment="Center" Foreground="#34D399" Text="&#xE895;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l:T 'Updates'}" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateText" FontSize="12" Style="{StaticResource SecondaryTextStyle}"
                               Text="{l:T 'WinModes can ask GitHub whether a newer release exists. Nothing is downloaded or installed by itself.'}" />
                    <CheckBox x:Name="CheckAtStartup" Content="{l:T 'Check once when WinModes starts'}" Margin="0,6,0,0"
                              Checked="OnCheckAtStartupChanged" Unchecked="OnCheckAtStartupChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="CheckButton" Content="{l:T 'Check now'}" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnCheckUpdates" />
                    <ui:Button x:Name="ReleasePageButton" Content="{l:T 'Release page'}" Icon="{ui:SymbolIcon Open24}"
                               Margin="8,0,0,0" Visibility="Collapsed" Click="OnOpenRelease" />
                    <ui:Button x:Name="InstallButton" Content="{l:T 'Download and install'}" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary"
                               Margin="8,0,0,0" Visibility="Collapsed" Click="OnInstallUpdate" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconBadgeStyle}" Background="#3360A5FA">
                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="17" HorizontalAlignment="Center" Foreground="#60A5FA" Text="&#xE9F9;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l:T 'Report for getting help'}" FontWeight="SemiBold" />
                    <TextBlock x:Name="ReportText" FontSize="12" Style="{StaticResource SecondaryTextStyle}"
                               Text="{l:T 'Saves a snapshot of this PC (memory, AI tools, largest programs) as a text file. It contains program names and totals only: no folder, command line, project or account name.'}" />
                </StackPanel>
                <ui:Button Grid.Column="2" Content="{l:T 'Export report'}" Icon="{ui:SymbolIcon DocumentArrowDown20}" VerticalAlignment="Center"
                           Margin="12,0,0,0" Click="OnExportReport" />
            </Grid>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconBadgeStyle}" Background="#33C084FC">
                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="17" HorizontalAlignment="Center" Foreground="#C084FC" Text="&#xE90F;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l:T 'Support file'}" FontWeight="SemiBold" />
                    <TextBlock x:Name="SupportText" FontSize="12" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                               Text="{l:T 'Saves a zip to attach to a bug report: the version, facts about this PC, your settings and the error logs. Your user name, PC name, e-mail addresses and anything that looks like a key are taken out. Nothing is sent: you decide whether to share it.'}" />
                </StackPanel>
                <ui:Button Grid.Column="2" Content="{l:T 'Create support file'}" Icon="{ui:SymbolIcon FolderZip24}" VerticalAlignment="Center"
                           Margin="12,0,0,0" Click="OnCreateSupportFile" />
            </Grid>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconBadgeStyle}" Background="#33FBBF24">
                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="17" HorizontalAlignment="Center" Foreground="#FBBF24" Text="&#xEB51;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l:T 'Support the project'}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:T 'WinModes is free for noncommercial use. If it helps you, you can buy the author a coffee.'}"
                               FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="{l:T 'Welcome guide'}" Icon="{ui:SymbolIcon Lightbulb24}" Margin="0,0,8,0" Click="OnShowGuide" />
                    <ui:Button Content="{l:T 'Source code'}" Icon="{ui:SymbolIcon Code24}" Margin="0,0,8,0" Click="OnOpenSource" />
                    <ui:Button Content="{l:T 'Buy me a coffee'}" Icon="{ui:SymbolIcon DrinkCoffee24}" Appearance="Primary" Click="OnBuyCoffee" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{l:T 'SYSTEM'}" Style="{StaticResource CardCaptionStyle}" />
                <ItemsControl x:Name="SystemRows" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Key}" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="{l:T 'BUILT WITH'}" Style="{StaticResource CardCaptionStyle}" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="{l:T '.NET 10 and WPF (Microsoft, MIT licence). WPF-UI 4.3 by lepo.co (MIT licence). Icons: Segoe Fluent Icons, shipped with Windows 11.'}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}"
                           Text="{l:T 'Graph style inspired by Task Manager TMOG and the layout by OMEN Gaming Hub; no code or assets from either product are used.'}" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
