<Page x:Class="WinModes.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="RowStyle" TargetType="Border">
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource AppCardStrokeBrush}" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CardCaptionStyle}">
            <Setter Property="Margin" Value="4,20,0,8" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="36,24,36,36" MaxWidth="1100">
        <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="Changes are saved as you make them." Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />

        <TextBlock Text="STARTUP" Style="{StaticResource SectionTitleStyle}" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <StackPanel>
                <Border Style="{StaticResource RowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                            <TextBlock Text="Start WinModes automatically when you sign in." FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="StartWithWindows" Grid.Column="1" VerticalAlignment="Center"
                                         Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Start with Windows" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource RowStyle}" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start minimized" FontWeight="SemiBold" />
                            <TextBlock Text="When started with Windows, stay hidden in the notification area instead of opening the window."
                                       FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="StartMinimized" Grid.Column="1" VerticalAlignment="Center"
                                         Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Start minimized" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="WINDOW" Style="{StaticResource SectionTitleStyle}" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <Border Style="{StaticResource RowStyle}" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Keep running in the notification area" FontWeight="SemiBold" />
                        <TextBlock Text="The close button hides the window; use Quit in the tray menu to exit. Turn off to exit when the window closes."
                                   FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="CloseToTray" Grid.Column="1" VerticalAlignment="Center"
                                     Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Keep running in the notification area" />
                </Grid>
            </Border>
        </Border>

        <TextBlock Text="DISPLAY" Style="{StaticResource SectionTitleStyle}" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <StackPanel>
                <Border Style="{StaticResource RowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Show AI memory on the tray icon" FontWeight="SemiBold" />
                            <TextBlock Text="The notification-area icon shows the memory used by AI tools, in GB. Hover it for the detail per tool."
                                       FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ShowAiMemoryInTray" Grid.Column="1" VerticalAlignment="Center"
                                         Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Show AI memory on the tray icon" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource RowStyle}" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Desktop widget" FontWeight="SemiBold" />
                            <TextBlock Text="A small always-on-top panel with CPU, memory and AI tools. Drag it anywhere; right-click it to hide it."
                                       FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ShowDesktopWidget" Grid.Column="1" VerticalAlignment="Center"
                                         Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Desktop widget" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="MODES" Style="{StaticResource SectionTitleStyle}" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <StackPanel>
                <Border Style="{StaticResource RowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ask before activating a mode" FontWeight="SemiBold" />
                            <TextBlock Text="Show a summary of the changes and wait for your confirmation." FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ConfirmBeforeActivate" Grid.Column="1" VerticalAlignment="Center"
                                         Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Ask before activating a mode" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource RowStyle}" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Activate a mode when WinModes starts" FontWeight="SemiBold" />
                            <TextBlock Text="Windows asks for administrator permission each time. Skipped when a mode is already active."
                                       FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="AutoMode" Grid.Column="1" MinWidth="170" VerticalAlignment="Center"
                                  DisplayMemberPath="Label" SelectionChanged="OnAutoModeChanged"
                                  AutomationProperties.Name="Mode to activate when WinModes starts" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="SHORTCUTS AND ALERTS" Style="{StaticResource SectionTitleStyle}" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <StackPanel>
                <Border Style="{StaticResource RowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Global keyboard shortcuts" FontWeight="SemiBold" />
                            <TextBlock Text="Ctrl+Alt+1, 2, 3 activate the modes in the order of their cards; Ctrl+Alt+0 deactivates. They work from any app."
                                       FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="EnableHotkeys" Grid.Column="1" VerticalAlignment="Center"
                                         Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Global keyboard shortcuts" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource RowStyle}" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Alert when AI tools use too much memory" FontWeight="SemiBold" />
                            <TextBlock Text="Shows a notification when all AI tools together reach the limit."
                                       FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="AiAlert" Grid.Column="1" MinWidth="170" VerticalAlignment="Center"
                                  DisplayMemberPath="Label" SelectionChanged="OnAutoModeChanged"
                                  AutomationProperties.Name="AI tools memory alert limit" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="DATA" Style="{StaticResource SectionTitleStyle}" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <Border Style="{StaticResource RowStyle}" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Switch history" FontWeight="SemiBold" />
                        <TextBlock x:Name="JournalPath" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}" Click="OnOpenJournal" />
                </Grid>
            </Border>
        </Border>

        <TextBlock Margin="4,16,0,0" FontSize="12" Style="{StaticResource SecondaryTextStyle}"
                   Text="Planned, not built yet: switching by itself when a game or a coding tool starts, and switching without a permission prompt." />
    </StackPanel>
</Page>
