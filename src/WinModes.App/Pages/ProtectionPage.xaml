<Page x:Class="WinModes.App.Pages.ProtectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinModes.App.Localization"
      xmlns:app="clr-namespace:WinModes.App"
      xmlns:controls="clr-namespace:WinModes.App.Controls"
      Title="{l:T 'Protection'}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="36,24,36,36" MaxWidth="1100">
        <controls:PageHeader Title="{l:T 'Protection'}" Icon="Shield24" Accent="{x:Static app:Palette.Start}" Margin="0,0,0,24">
            <TextBlock Text="{l:T 'What no mode is ever allowed to touch.'}" Style="{StaticResource SecondaryTextStyle}" />
        </controls:PageHeader>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource GlyphTextStyle}" VerticalAlignment="Top" Text="&#xE72E;" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{l:T 'Always protected'}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"
                               Text="{l:T 'No mode can stop, disable or remove: Defender, Bitdefender, AdGuard, the firewall and Windows Update; WSL and Docker components; winget, the Microsoft Store and Chocolatey; Edge and WebView2; your AI and developer tools, Discord and Spotify.'}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource GlyphTextStyle}" VerticalAlignment="Top" Text="&#xE7A7;" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{l:T 'Reversible by design'}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"
                               Text="{l:T 'Services are set to Manual, never Disabled. Nothing is uninstalled. Each switch will record the previous state so it can be undone.'}" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</Page>
