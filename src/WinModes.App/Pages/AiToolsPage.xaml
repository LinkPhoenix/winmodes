<Page x:Class="WinModes.App.Pages.AiToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinModes.App.Localization"
      xmlns:app="clr-namespace:WinModes.App"
      xmlns:controls="clr-namespace:WinModes.App.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'AI tools'}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="36,24,36,36" MaxWidth="1400">
        <controls:PageHeader Title="{l:T 'AI tools'}" Icon="Bot24" Accent="{x:Static app:Palette.Apps}">
            <TextBlock x:Name="Summary" Text="{l:T 'Looking for AI and coding tools…'}" Style="{StaticResource SecondaryTextStyle}" />
            <controls:PageHeader.Actions>
                <ui:Button x:Name="EndIdleButton" Content="{l:T 'End idle sessions'}" Icon="{ui:SymbolIcon Broom24}"
                           IsEnabled="False" Click="OnEndIdle"
                           ToolTip="{l:T 'Ends project sessions that used no CPU for 30 minutes while WinModes was watching.'}" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Border x:Name="EmptyState" Style="{StaticResource CardBorderStyle}" Padding="32" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="&#xE99A;" />
                <TextBlock Text="{l:T 'No AI tool is running'}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Text="{l:T 'Claude, Codex, Cursor, VS Code, T3 Code, OpenCode, Windsurf, Ollama and LM Studio are recognised.'}"
                           Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border x:Name="DuplicateCard" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="{l:T 'MCP SERVERS RUNNING IN SEVERAL SESSIONS'}" Style="{StaticResource CardCaptionStyle}" />
                <TextBlock x:Name="DuplicateSummary" FontSize="12" Margin="0,4,0,6" Style="{StaticResource SecondaryTextStyle}" />
                <ItemsControl x:Name="Duplicates">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Grid.Column="2" Text="{Binding Memory}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <ItemsControl x:Name="Tools">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,20">
                        <Grid Margin="4,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="24" Height="24" Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="16" Text="&#xE99A;" Visibility="{Binding GlyphVisibility}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                <Image Source="{Binding Icon}" Width="24" Height="24" />
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Summary}" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Sessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:CardExpander Margin="0,0,0,6" ContentPadding="0" IsExpanded="{Binding IsExpanded, Mode=OneTime}"
                                                     Expanded="OnExpanded" Collapsed="OnCollapsed"
                                                     ContextMenuOpening="OnMenuOpening" ContextMenuClosing="OnMenuClosing">
                                        <ui:CardExpander.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{l:T 'Open session folder'}" Click="OnOpenFolder" IsEnabled="{Binding HasFolder}" />
                                                <MenuItem Header="{l:T 'Copy folder path'}" Click="OnCopyFolder" IsEnabled="{Binding HasFolder}" />
                                                <MenuItem Header="{l:T 'Copy PID'}" Click="OnCopyPid" />
                                                <Separator />
                                                <MenuItem Header="{l:T 'End this session and its processes'}" Click="OnEndSession" />
                                            </ContextMenu>
                                        </ui:CardExpander.ContextMenu>
                                        <ui:CardExpander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="230" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource IconBadgeStyle}" Background="#337C5CFC">
                                                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="16" HorizontalAlignment="Center"
                                                               Foreground="#A78BFA" Text="{Binding Glyph}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <Border Style="{StaticResource ChipStyle}" Margin="10,0,0,0" Padding="8,1" Background="#33FBBF24"
                                                                Visibility="{Binding IdleVisibility}">
                                                            <TextBlock Text="{Binding IdleText}" FontSize="11" FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding Subtitle}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding ProcessText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           Style="{StaticResource SecondaryTextStyle}" />
                                                <TextBlock Grid.Column="3" Text="{Binding CpuText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           Style="{StaticResource SecondaryTextStyle}" />
                                                <TextBlock Grid.Column="4" Text="{Binding MemoryText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           FontWeight="SemiBold" Margin="0,0,16,0" />
                                            </Grid>
                                        </ui:CardExpander.Header>
                                        <ItemsControl ItemsSource="{Binding Processes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="16,7" BorderThickness="0,1,0,0" BorderBrush="{StaticResource AppCardStrokeBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="220" />
                                                                <ColumnDefinition Width="70" />
                                                                <ColumnDefinition Width="70" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Grid Width="18" Height="18" Margin="0,0,10,0">
                                                                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="13" Text="&#xECAA;"
                                                                               Visibility="{Binding GlyphVisibility}" HorizontalAlignment="Center"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    <Image Source="{Binding Icon}" Width="18" Height="18" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                                                <Border Style="{StaticResource ChipStyle}" Margin="8,0,0,0" Padding="6,0" Background="#3360A5FA"
                                                                        Visibility="{Binding McpVisibility}" ToolTip="{l:T 'Model Context Protocol server started by this session'}">
                                                                    <TextBlock Text="MCP" FontSize="10" FontWeight="SemiBold" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Pid}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Style="{StaticResource SecondaryTextStyle}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding CpuText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Style="{StaticResource SecondaryTextStyle}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding MemoryText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="4" Text="{Binding Command}" Margin="20,0,0,0" VerticalAlignment="Center" FontSize="12"
                                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ui:CardExpander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
