<Page x:Class="WinModes.App.Pages.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinModes.App.Localization"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Processes'}"
      ScrollViewer.CanContentScroll="False"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="SortHeaderStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChevronButtonStyle" TargetType="Button" BasedOn="{StaticResource SortHeaderStyle}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource GlyphFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ProcessRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource AppCardStrokeBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <!-- The page scrolls its list itself (the shell's scrolling is off): only the rows in view are built, and the column titles stay in view. -->
    <Grid Margin="36,24,36,24" MaxWidth="1400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
        <TextBlock Text="{l:T 'Processes'}" FontSize="28" FontWeight="SemiBold" />
        <TextBlock x:Name="Summary" Text="{l:T 'Reading processes…'}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,16" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SearchBox" PlaceholderText="{l:T 'Search by name, PID or command line'}" Icon="{ui:SymbolIcon Search24}"
                        TextChanged="OnFilterChanged" AutomationProperties.Name="{l:T 'Search processes'}" />
            <CheckBox x:Name="ProtectedOnly" Grid.Column="1" Content="{l:T 'Protected only'}" Margin="16,0,0,0"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
        </Grid>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Padding="16,8" BorderThickness="0,0,0,1" BorderBrush="{StaticResource AppCardStrokeBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SortName" Style="{StaticResource SortHeaderStyle}" Tag="Name" HorizontalAlignment="Left" Click="OnSortClick" />
                        <Button x:Name="SortPid" Grid.Column="1" Style="{StaticResource SortHeaderStyle}" Tag="Pid" HorizontalAlignment="Right" Click="OnSortClick" />
                        <Button x:Name="SortCpu" Grid.Column="2" Style="{StaticResource SortHeaderStyle}" Tag="Cpu" HorizontalAlignment="Right" Click="OnSortClick" />
                        <Button x:Name="SortMemory" Grid.Column="3" Style="{StaticResource SortHeaderStyle}" Tag="Memory" HorizontalAlignment="Right" Click="OnSortClick" />
                        <Button x:Name="SortThreads" Grid.Column="4" Style="{StaticResource SortHeaderStyle}" Tag="Threads" HorizontalAlignment="Right" Click="OnSortClick" />
                        <TextBlock Grid.Column="5" Text="{l:T 'Command'}" FontSize="12" FontWeight="SemiBold" Margin="20,4,0,4"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>

                <!-- One menu for the whole list, filled for the row under the pointer when it opens: a menu per row made the page slow to build. -->
                <ItemsControl x:Name="Rows" Grid.Row="1" ContextMenuOpening="OnMenuOpening" ContextMenuClosing="OnMenuClosing"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:T 'End task'}" Click="OnEndTask" />
                            <MenuItem Header="{l:T 'End process tree'}" Click="OnEndTree" />
                            <Separator />
                            <MenuItem Header="{l:T 'Open file location'}" Click="OnOpenLocation" IsEnabled="{Binding HasPath}" />
                            <MenuItem Header="{l:T 'Open working folder'}" Click="OnOpenFolder" IsEnabled="{Binding HasFolder}" />
                            <MenuItem Header="{l:T 'Search online'}" Click="OnSearchOnline" />
                            <Separator />
                            <MenuItem Header="{l:T 'Copy process name'}" Click="OnCopyName" />
                            <MenuItem Header="{l:T 'Copy PID'}" Click="OnCopyPid" />
                            <MenuItem Header="{l:T 'Copy command line'}" Click="OnCopyCommand" IsEnabled="{Binding HasCommand}" />
                        </ContextMenu>
                    </ItemsControl.ContextMenu>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProcessRowStyle}" DataContext="{Binding Data}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ChevronButtonStyle}" Content="{Binding Chevron}" Click="OnToggle"
                                                Visibility="{Binding ChevronVisibility}" ToolTip="{l:T 'Show or hide child processes'}"
                                                AutomationProperties.Name="{l:T 'Show or hide child processes'}" />
                                        <Grid Width="20" Height="20" Margin="2,0,10,0">
                                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="14" Text="&#xECAA;" Visibility="{Binding GlyphVisibility}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                            <Image Source="{Binding Icon}" Width="20" Height="20" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                        <TextBlock Text="{Binding ChildText}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                        <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="11" Text="&#xE72E;" Margin="8,0,0,0"
                                                   Foreground="#A78BFA" Visibility="{Binding ProtectedVisibility}"
                                                   ToolTip="{l:T 'Protected: no mode can close this app.'}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Pid}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{Binding CpuText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{Binding CpuColor}" />
                                    <TextBlock Grid.Column="3" Text="{Binding MemoryText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="{Binding MemoryColor}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Threads}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Grid.Column="5" Text="{Binding Command}" Margin="20,0,0,0" VerticalAlignment="Center" FontSize="12"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Command}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</Page>
