<Page x:Class="WinModes.App.Pages.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Processes"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="SortHeaderStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <StackPanel Margin="36,24,36,36" MaxWidth="1100">
        <TextBlock Text="Processes" FontSize="28" FontWeight="SemiBold" />
        <TextBlock x:Name="Summary" Text="Reading processes…" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,16" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SearchBox" PlaceholderText="Search by name" Icon="{ui:SymbolIcon Search24}"
                        TextChanged="OnFilterChanged" AutomationProperties.Name="Search processes" />
            <CheckBox x:Name="ProtectedOnly" Grid.Column="1" Content="Protected only" Margin="16,0,0,0"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
        </Grid>

        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <StackPanel>
                <Border Padding="20,8" BorderThickness="0,0,0,1" BorderBrush="{StaticResource AppCardStrokeBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="262" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SortName" Style="{StaticResource SortHeaderStyle}" Content="Name" Tag="Name"
                                HorizontalAlignment="Left" Click="OnSortClick" ToolTip="Sort by name" />
                        <Button x:Name="SortCount" Grid.Column="1" Style="{StaticResource SortHeaderStyle}" Content="Instances" Tag="Count"
                                HorizontalAlignment="Left" Click="OnSortClick" ToolTip="Sort by number of processes" />
                        <Button x:Name="SortMemory" Grid.Column="3" Style="{StaticResource SortHeaderStyle}" Content="Memory" Tag="Memory"
                                HorizontalAlignment="Right" Click="OnSortClick" ToolTip="Sort by private memory" />
                    </Grid>
                </Border>

                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="20,10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource AppCardStrokeBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="262" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="22" Height="22" Margin="0,0,12,0">
                                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="15" Text="&#xECAA;" Visibility="{Binding GlyphVisibility}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                            <Image Source="{Binding Icon}" Width="22" Height="22" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CountText}" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                                    <ProgressBar Grid.Column="2" Height="6" Minimum="0" Maximum="100" Value="{Binding Share, Mode=OneWay}"
                                                 Foreground="{Binding Color}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding MemoryText}" HorizontalAlignment="Right" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="4" Style="{StaticResource ChipStyle}" HorizontalAlignment="Right"
                                            Background="#337C5CFC" Visibility="{Binding ProtectedVisibility}"
                                            ToolTip="Protected: no mode can close this app.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="11" Text="&#xE72E;" Margin="0,0,6,0" />
                                            <TextBlock Text="Protected" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
