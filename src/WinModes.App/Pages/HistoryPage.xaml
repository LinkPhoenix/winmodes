<Page x:Class="WinModes.App.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinModes.App.Localization"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'History'}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="36,24,36,36" MaxWidth="1100">
        <TextBlock Text="{l:T 'History'}" FontSize="28" FontWeight="SemiBold" />
        <TextBlock x:Name="Summary" Text="{l:T 'Every mode switch is recorded here with the state it replaced.'}"
                   Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,24" />

        <Border x:Name="EmptyState" Style="{StaticResource CardBorderStyle}" Padding="32">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="&#xE81C;" />
                <TextBlock Text="{l:T 'No mode has been activated yet'}" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Text="{l:T 'Activate a mode from the Modes page; the switch will appear here.'}"
                           Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ItemsControl x:Name="Sessions">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:CardExpander Margin="0,0,0,8" ContentPadding="0">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadgeStyle}" Background="{Binding Accent}">
                                    <TextBlock Style="{StaticResource GlyphTextStyle}" FontSize="17" HorizontalAlignment="Center"
                                               Foreground="White" Text="{Binding Glyph}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource ChipStyle}" Margin="0,0,16,0" Background="{Binding StatusTint}">
                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </ui:CardExpander.Header>
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Outcome}" VerticalAlignment="Center"
                                                       Foreground="{Binding OutcomeColor}" FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ui:CardExpander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
